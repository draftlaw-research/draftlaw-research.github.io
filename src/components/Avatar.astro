---
import { Image } from 'astro:assets';
import { initials } from '../lib/content';
import { getPhoto } from '../lib/images';

interface Props {
  name: string;
  photo?: string; // path such as /src/assets/authors/name.jpg
  big?: boolean;
}
const { name, photo, big = false } = Astro.props;
const picture = getPhoto(photo);
---

<span class:list={['avatar', big && 'big']} aria-hidden="true">
  {picture ? <Image src={picture} alt="" width={big ? 192 : 144} height={big ? 192 : 144} /> : initials(name)}
</span>
