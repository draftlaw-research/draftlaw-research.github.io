
---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Avatar from '../../components/Avatar.astro';
import { getCountryAmbassadors } from '../../lib/content';

export async function getStaticPaths() {
  const ambassadors = await getCountryAmbassadors();

  return ambassadors.map((ambassador) => ({
    params: { member: ambassador.id },
    props: { member: ambassador },
  }));
}

const { member } = Astro.props;
const { Content } = await render(member);
const d = member.data;

const line = [d.occupation, d.affiliation]
  .filter(Boolean)
  .join(', ');
---

<Base
  title={d.name}
  description={`${d.name}, Country Ambassador for ${d.country} at DraftLaw Research.`}
>
  <div class="wrap">
    <div class="author-head">
      <Avatar name={d.name} photo={d.photo} big />

      <div>
        <p class="eyebrow">
          <a href="/about/#country-ambassadors">
            Country Ambassadors
          </a>
        </p>

        <h1>{d.name}</h1>

        <p class="role">
          <strong>Country Ambassador</strong>, {d.country}
        </p>

        {line && <p class="role">{line}</p>}

        <ul class="links">
          {d.linkedin && (
            <li>
              <a
                href={d.linkedin}
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn
              </a>
            </li>
          )}

          {d.facebook && (
            <li>
              <a
                href={d.facebook}
                target="_blank"
                rel="noopener noreferrer"
              >
                Facebook
              </a>
            </li>
          )}

          {d.instagram && (
            <li>
              <a
                href={d.instagram}
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram
              </a>
            </li>
          )}

          {d.website && (
            <li>
              <a
                href={d.website}
                target="_blank"
                rel="noopener noreferrer"
              >
                Website
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="page-text">
      <Content />
    </div>
  </div>
</Base>
