
---
export const prerender = true;

import Editorial from '../../../../layouts/Editorial.astro';
---

<Editorial title="My Drafts">
  <main class="drafts-page">
    <a class="back-link" href="/editorial/submissions/">
      ← Back to Submission Centre
    </a>

    <header class="page-heading">
      <p class="eyebrow">EDITORIAL WORKSPACE</p>
      <h1>My drafts</h1>
      <p>View your saved article and guide drafts.</p>
    </header>

    <div id="draft-message" class="message" role="status">
      Loading your drafts...
    </div>

    <div id="draft-list" class="draft-list"></div>

    <a class="new-button" href="/editorial/submissions/new/">
      Create a new submission
    </a>
  </main>
</Editorial>

<script>
  type Draft = {
    id: string;
    title: string;
    contentType: string;
    createdAt?: string;
    updatedAt?: string;
  };

  const message = document.querySelector<HTMLDivElement>('#draft-message')!;
  const draftList = document.querySelector<HTMLDivElement>('#draft-list')!;

  function showMessage(text: string, type = '') {
    message.textContent = text;
    message.className = `message ${type}`;
    message.hidden = false;
  }

  function formatDate(value?: string) {
    if (!value) return 'Date unavailable';

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) return 'Date unavailable';

    return date.toLocaleString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    });
  }

  function renderDrafts(drafts: Draft[]) {
    draftList.replaceChildren();

    if (drafts.length === 0) {
      showMessage('You do not have any saved drafts yet.');
      return;
    }

    message.hidden = true;

    drafts.forEach((draft) => {
      const card = document.createElement('article');
      card.className = 'draft-card';

      const title = document.createElement('h2');
      title.textContent = draft.title || 'Untitled draft';

      const type = document.createElement('span');
      type.className = 'draft-type';
      type.textContent =
        draft.contentType === 'guide' ? 'Guide' : 'Article';

      const updated = document.createElement('p');
      updated.className = 'draft-date';
      updated.textContent = `Last updated: ${formatDate(draft.updatedAt)}`;

      card.append(title, type, updated);
      draftList.append(card);
    });
  }

  async function loadDrafts() {
    try {
      const response = await fetch('/api/submissions/draft', {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store'
      });

      const result = await response.json();

      if (!response.ok || !result.ok) {
        if (response.status === 401 || response.status === 403) {
          window.location.replace('/editorial');
          return;
        }

        throw new Error(result.message || 'Could not load your drafts.');
      }

      const drafts: Draft[] = Array.isArray(result.drafts)
        ? result.drafts
        : [];

      renderDrafts(drafts);
    } catch (error) {
      showMessage(
        error instanceof Error
          ? error.message
          : 'Something went wrong. Please refresh the page.',
        'error'
      );
    }
  }

  loadDrafts();
</script>

<style>
  .drafts-page {
    width: min(100% - 2rem, 1000px);
    margin: 0 auto;
    padding: 3rem 0 5rem;
  }

  .back-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.85rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .page-heading {
    margin: 2rem 0;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--rule);
  }

  .eyebrow {
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
  }

  .page-heading h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .page-heading p:last-child {
    color: var(--muted);
    line-height: 1.7;
  }

  .message {
    margin: 1rem 0;
    padding: 1rem;
    border: 1px solid var(--rule);
    color: var(--ink);
    line-height: 1.6;
  }

  .message.error {
    border-color: #a85b4c;
    color: #e3a394;
  }

  .draft-list {
    display: grid;
    gap: 1rem;
  }

  .draft-card {
    padding: 1.3rem;
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .draft-card h2 {
    margin: 0 0 0.7rem;
    color: var(--ink);
    font-size: 1.15rem;
  }

  .draft-type {
    display: inline-block;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 0.75rem;
  }

  .draft-date {
    margin: 0.8rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .new-button {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    text-decoration: none;
    border-radius: 3px;
  }

  @media (max-width: 600px) {
    .drafts-page {
      padding-top: 2rem;
    }
  }
</style>
