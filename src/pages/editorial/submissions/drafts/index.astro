
---
export const prerender = true;

import Editorial from '../../../../layouts/Editorial.astro';
---

<Editorial title="My Drafts">
  <main class="drafts-page">
    <header class="page-heading">
      <a href="/editorial/submissions/" class="back-link">← Back to Submission Centre</a>
      <p class="eyebrow">EDITORIAL WORKSPACE</p>
      <h1>My drafts</h1>
      <p class="intro">
        Find the submissions you have saved as drafts. Only your own drafts
        are shown here.
      </p>
    </header>

    <div id="page-message" class="status-message" role="status">
      Checking your login and loading your drafts...
    </div>

    <section
      id="draft-list"
      class="draft-list"
      aria-label="Your saved drafts"
      hidden
    ></section>

    <section id="empty-state" class="empty-state" hidden>
      <p class="eyebrow">NO SAVED WORK</p>
      <h2>No drafts yet</h2>
      <p>You have not saved any article or guide drafts.</p>
    </section>
  </main>
</Editorial>

<script>
  const message = document.querySelector('#page-message');
  const draftList = document.querySelector('#draft-list');
  const emptyState = document.querySelector('#empty-state');

  function showMessage(text, type = '') {
    message.textContent = text;
    message.className = `status-message ${type}`;
    message.hidden = false;
  }

  function formatDate(value) {
    if (!value) return 'Date unavailable';

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return 'Date unavailable';
    }

    return date.toLocaleString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    });
  }

  function createDraftCard(draft) {
    const card = document.createElement('article');
    card.className = 'draft-card';

    const details = document.createElement('div');
    details.className = 'draft-details';

    const title = document.createElement('h2');
    title.textContent = draft.title || 'Untitled submission';

    const type = document.createElement('span');
    type.className = 'draft-type';
    type.textContent =
      draft.contentType === 'guide' ? 'Guide' : 'Article';

    const dates = document.createElement('div');
    dates.className = 'draft-dates';

    const updated = document.createElement('p');
    updated.textContent =
      `Last updated: ${formatDate(draft.updatedAt || draft.createdAt)}`;

    const created = document.createElement('p');
    created.textContent =
      `Created: ${formatDate(draft.createdAt)}`;

    dates.append(updated, created);
    details.append(title, type, dates);

    const actions = document.createElement('div');
    actions.className = 'draft-actions';

    const openLink = document.createElement('a');
    openLink.className = 'open-draft-link';
    openLink.textContent = 'Open draft →';
    openLink.href =
      `/editorial/submissions/new/?id=${encodeURIComponent(draft.id)}`;

    openLink.setAttribute(
      'aria-label',
      `Open draft: ${draft.title || 'Untitled submission'}`
    );

    actions.append(openLink);
    card.append(details, actions);

    return card;
  }

  async function loadDrafts() {
    try {
      const sessionResponse = await fetch('/api/auth/me', {
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!sessionResponse.ok) {
        window.location.replace('/editorial/');
        return;
      }

      const sessionData = await sessionResponse.json();

      if (!sessionData.ok || sessionData.user?.role !== 'editor') {
        showMessage(
          'Access denied. This page is available to Editors only.',
          'error-message'
        );
        return;
      }

      const response = await fetch('/api/submissions/draft', {
        credentials: 'same-origin',
        cache: 'no-store'
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(data.message || 'Could not load your drafts.');
      }

      const drafts = Array.isArray(data.drafts) ? data.drafts : [];

      message.hidden = true;
      draftList.replaceChildren();
      draftList.hidden = true;
      emptyState.hidden = true;

      if (drafts.length === 0) {
        emptyState.hidden = false;
        return;
      }

      drafts.forEach((draft) => {
        draftList.append(createDraftCard(draft));
      });

      draftList.hidden = false;

    } catch (error) {
      showMessage(
        error.message || 'Something went wrong while loading your drafts.',
        'error-message'
      );
    }
  }

  loadDrafts();
</script>

<style>
  .drafts-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .page-heading {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .eyebrow {
    margin: 0 0 0.65rem;
    color: var(--accent);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    font-weight: 700;
  }

  .page-heading h1 {
    margin: 0.5rem 0;
  }

  .intro {
    max-width: 65ch;
    color: var(--muted);
    line-height: 1.7;
  }

  .status-message {
    padding: 1.5rem 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .error-message {
    color: #b42318;
  }

  .draft-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .draft-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 220px;
    padding: 1.7rem;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: inherit;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .draft-card:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
  }

  .draft-details {
    width: 100%;
    min-width: 0;
  }

  .draft-card h2 {
    margin: 0 0 0.9rem;
    font-size: 1.3rem;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .draft-type {
    display: inline-block;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--rule);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .draft-dates {
    margin-top: 1.1rem;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.6;
  }

  .draft-dates p {
    margin: 0.25rem 0;
  }

  .draft-actions {
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .open-draft-link {
    display: inline-block;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .open-draft-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .empty-state {
    padding: 2.5rem 1.5rem;
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .empty-state h2 {
    margin: 0.5rem 0;
  }

  .empty-state > p:last-child {
    margin-bottom: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 750px) {
    .drafts-page {
      padding-inline: 1rem;
    }

    .draft-list {
      grid-template-columns: 1fr;
    }

    .draft-card {
      min-height: 190px;
    }
  }
</style>
