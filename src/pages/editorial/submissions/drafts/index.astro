
---
export const prerender = true;

import Editorial from '../../../../layouts/Editorial.astro';
---

<Editorial title="My Drafts">
  <section class="drafts-page">
    <div class="page-heading">
      <a href="/editorial/submissions/" class="back-link">
        ← Back to Submission Centre
      </a>

      <p class="eyebrow">EDITORIAL WORKSPACE</p>
      <h1>My drafts</h1>
      <p class="intro">
        Find the submissions you have saved as drafts. Only your own drafts
        are shown here.
      </p>
    </div>

    <div id="page-message" class="message" role="status">
      Checking your login and loading your drafts...
    </div>

    <div id="draft-list" class="draft-list" hidden></div>

    <div id="empty-state" class="empty-state" hidden>
      <h2>No drafts yet</h2>
      <p>
        You have not saved any article or guide drafts.
        Create a submission to get started.
      </p>
      <a href="/editorial/submissions/new/" class="primary-link">
        Create a submission
      </a>
    </div>

    <div class="page-actions">
      <a href="/editorial/submissions/new/" class="primary-link">
        + Create a new submission
      </a>
    </div>
  </section>
</Editorial>

<script>
  const message = document.querySelector('#page-message');
  const draftList = document.querySelector('#draft-list');
  const emptyState = document.querySelector('#empty-state');

  function showMessage(text, type = '') {
    message.textContent = text;
    message.className = `message ${type}`;
    message.hidden = false;
  }

  function formatDate(value) {
    if (!value) return 'Date unavailable';

    const date = new Date(value);

    if (Number.isNaN(date.getTime())) {
      return 'Date unavailable';
    }

    return date.toLocaleString(undefined, {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit'
    });
  }

  function createDraftCard(draft) {
    const card = document.createElement('article');
    card.className = 'draft-card';

    const details = document.createElement('div');
    details.className = 'draft-details';

    const title = document.createElement('h2');
    title.textContent = draft.title || 'Untitled submission';

    const type = document.createElement('span');
    type.className = 'draft-type';
    type.textContent =
      draft.contentType === 'guide' ? 'Guide' : 'Article';

    const updated = document.createElement('p');
    updated.className = 'draft-date';
    updated.textContent =
      `Last updated: ${formatDate(draft.updatedAt || draft.createdAt)}`;

    const created = document.createElement('p');
    created.className = 'draft-date';
    created.textContent =
      `Created: ${formatDate(draft.createdAt)}`;

    details.append(title, type, updated, created);

    const actions = document.createElement('div');
    actions.className = 'draft-actions';

    const editLink = document.createElement('a');
    editLink.className = 'edit-link';
    editLink.textContent = 'Open draft';

    // Draft editing will be connected in the next development step.
    editLink.href =
      `/editorial/submissions/new/?id=${encodeURIComponent(draft.id)}`;

    actions.append(editLink);
    card.append(details, actions);

    return card;
  }

  async function loadDrafts() {
    try {
      const sessionResponse = await fetch('/api/auth/me', {
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!sessionResponse.ok) {
        window.location.replace('/editorial/');
        return;
      }

      const sessionData = await sessionResponse.json();

      if (!sessionData.ok || sessionData.user?.role !== 'editor') {
        showMessage(
          'Access denied. This page is available to Editors only.',
          'error'
        );
        return;
      }

      const response = await fetch('/api/submissions/draft', {
        credentials: 'same-origin',
        cache: 'no-store'
      });

      const data = await response.json();

      if (!response.ok || !data.ok) {
        throw new Error(data.message || 'Could not load your drafts.');
      }

      const drafts = Array.isArray(data.drafts) ? data.drafts : [];

      message.hidden = true;
      draftList.replaceChildren();
      draftList.hidden = true;
      emptyState.hidden = true;

      if (drafts.length === 0) {
        emptyState.hidden = false;
        return;
      }

      drafts.forEach((draft) => {
        draftList.append(createDraftCard(draft));
      });

      draftList.hidden = false;

    } catch (error) {
      showMessage(
        error.message || 'Something went wrong while loading your drafts.',
        'error'
      );
    }
  }

  loadDrafts();
</script>

<style>
  .drafts-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 36px 20px 70px;
  }

  .page-heading {
    margin-bottom: 30px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 25px;
    color: inherit;
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .eyebrow {
    margin: 0 0 10px;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    font-weight: 700;
    opacity: 0.65;
  }

  h1 {
    margin: 0 0 12px;
    font-size: clamp(2rem, 5vw, 2.8rem);
  }

  .intro {
    max-width: 650px;
    line-height: 1.7;
    opacity: 0.75;
  }

  .message {
    padding: 16px 18px;
    margin: 20px 0;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
    line-height: 1.6;
  }

  .message.error {
    border-color: #c66;
    color: #a22;
  }

  .draft-list {
    display: grid;
    gap: 15px;
    margin-top: 25px;
  }

  .draft-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px;
    border: 1px solid #dedede;
    border-radius: 10px;
    background: #fff;
  }

  .draft-details {
    min-width: 0;
  }

  .draft-card h2 {
    margin: 0 0 10px;
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }

  .draft-type {
    display: inline-block;
    padding: 4px 9px;
    border-radius: 5px;
    background: #f0f0f0;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .draft-date {
    margin: 9px 0 0;
    font-size: 0.85rem;
    color: #666;
  }

  .draft-actions {
    flex-shrink: 0;
  }

  .edit-link,
  .primary-link {
    display: inline-block;
    padding: 11px 17px;
    border-radius: 6px;
    background: #222;
    color: #fff;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .edit-link:hover,
  .primary-link:hover {
    background: #444;
  }

  .empty-state {
    padding: 35px 25px;
    margin-top: 25px;
    border: 1px dashed #ccc;
    border-radius: 10px;
    text-align: center;
  }

  .empty-state p {
    line-height: 1.7;
    margin-bottom: 22px;
  }

  .page-actions {
    margin-top: 28px;
  }

  @media (max-width: 600px) {
    .draft-card {
      align-items: flex-start;
      flex-direction: column;
    }

    .draft-actions {
      width: 100%;
    }

    .edit-link {
      text-align: center;
      width: 100%;
      box-sizing: border-box;
    }
  }
</style>
