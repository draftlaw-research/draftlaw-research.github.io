---
export const prerender = true;

import Editorial from '../../../layouts/Editorial.astro';
---

<Editorial title="New Submission">
  <section class="submission-page">
    <div class="page-heading">
      <a href="/editorial/dashboard/" class="back-link">← Back to dashboard</a>
      <p class="eyebrow">EDITORIAL WORKSPACE</p>
      <h1>Create a submission</h1>
      <p class="intro">
        Prepare a new article or guide. Save your work as a draft or submit it
        to the editorial team for review.
      </p>
    </div>

    <div id="page-message" class="message" role="status" hidden></div>

    <form id="submission-form" hidden>
      <div class="form-section">
        <h2>1. Content details</h2>

        <label for="content-type">Content type *</label>
        <select id="content-type" required>
          <option value="article">Article</option>
          <option value="guide">Guide</option>
        </select>

        <label for="title">Title *</label>
        <input id="title" type="text" maxlength="250" required
          placeholder="Enter the title" />

        <label for="summary">Summary *</label>
        <textarea id="summary" rows="3" maxlength="400" required
          placeholder="Write a short summary (maximum 400 characters)"></textarea>
        <p class="hint">Maximum 400 characters.</p>

        <label for="kind">Type *</label>
        <select id="kind" required></select>

        <label for="date">Publication date *</label>
        <input id="date" type="date" required />
      </div>

      <div class="form-section">
        <h2>2. Authors and topic</h2>

        <label for="author-search">Search and select authors *</label>
        <input id="author-search" type="search"
          placeholder="Start typing an author's name..."
          autocomplete="off" />

        <div id="selected-authors" class="selected-authors">
          <span class="hint">No authors selected yet.</span>
        </div>

        <div id="author-options" class="author-options">
          <p class="hint">Loading available authors...</p>
        </div>

        <p id="author-count" class="hint">No authors selected.</p>

        <div id="topic-field">
          <label for="topic">Topic <span id="topic-required">*</span></label>
          <select id="topic">
            <option value="">Loading available topics...</option>
          </select>
          <p class="hint">
            Articles require a topic. Guides may leave this field empty.
          </p>
        </div>

        <label for="keywords">Keywords</label>
        <input id="keywords" type="text"
          placeholder="human rights, international law, accountability" />
        <p class="hint">Separate keywords with commas.</p>
      </div>

      <div class="form-section">
        <h2>3. Cover image</h2>

        <label for="cover">Upload cover image (optional)</label>
        <input id="cover" type="file"
          accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

        <p class="hint">
          JPEG, PNG or WebP. Images larger than 200 KB will be compressed
          automatically without resizing. Recommended dimensions: 1200 × 630 pixels.
        </p>

        <div id="cover-preview-container" class="cover-preview-container" hidden>
          <img id="cover-preview" alt="Cover image preview" />
          <p id="cover-file-name" class="hint"></p>
          <button type="button" id="remove-cover" class="remove-cover">
            Remove image
          </button>
        </div>

        <label for="cover-alt">Image description</label>
        <input id="cover-alt" type="text" maxlength="1000"
          placeholder="Describe the image for screen readers" />

        <p class="hint">
          A short description helps readers using screen readers understand the image.
        </p>

        <label for="cover-credit">Image credit (optional)</label>
        <input id="cover-credit" type="text" maxlength="1000"
          placeholder="Photographer, source or licence information" />
      </div>

      <div class="form-section">
        <h2>4. Publication settings</h2>

        <label class="switch-option">
          <input id="featured" type="checkbox" />
          <span class="switch-control"></span>
          <span class="switch-text">
            <strong>Featured content</strong>
            <small>Mark this content to be featured on the website.</small>
          </span>
        </label>

        <label class="switch-option">
          <input id="peer-reviewed" type="checkbox" checked />
          <span class="switch-control"></span>
          <span class="switch-text">
            <strong>Blind peer reviewed</strong>
            <small>Mark this content as having undergone blind peer review.</small>
          </span>
        </label>
      </div>

      <div class="form-section">
        <h2>5. Full content</h2>

        <label>Main content *</label>

        <div class="editor-help">
          Use the toolbar to format your article. Your work will be converted
          into Markdown when it is saved.
        </div>

        <div class="editor-shell">
          <div class="editor-toolbar" role="toolbar" aria-label="Text formatting">
            <button type="button" data-action="undo" title="Undo">↶</button>
            <button type="button" data-action="redo" title="Redo">↷</button>
            <span class="toolbar-divider"></span>

            <select id="block-format" aria-label="Text style">
              <option value="paragraph">Paragraph</option>
              <option value="h1">Heading 1</option>
              <option value="h2">Heading 2</option>
              <option value="h3">Heading 3</option>
            </select>

            <span class="toolbar-divider"></span>
            <button type="button" data-action="bold" title="Bold"><strong>B</strong></button>
            <button type="button" data-action="italic" title="Italic"><em>I</em></button>
            <button type="button" data-action="underline" title="Underline"><u>U</u></button>
            <button type="button" data-action="strike" title="Strikethrough"><s>S</s></button>
            <button type="button" data-action="highlight" title="Highlight">▨</button>

            <span class="toolbar-divider"></span>
            <button type="button" data-action="bullet" title="Bullet list">• List</button>
            <button type="button" data-action="ordered" title="Numbered list">1. List</button>
            <button type="button" data-action="quote" title="Block quote">❝ Quote</button>
            <button type="button" data-action="code" title="Code block">Code</button>

            <span class="toolbar-divider"></span>
            <button type="button" data-action="link" title="Insert link">Link</button>
            <button type="button" data-action="image" title="Insert image">Image</button>
            <button type="button" data-action="table" title="Insert table">Table</button>
            <button type="button" data-action="formula" title="Insert formula">Formula</button>
            <button type="button" data-action="rule" title="Horizontal line">―</button>
          </div>

          <div id="rich-editor" class="rich-editor"></div>

          <div class="editor-footer">
            <span id="editor-word-count">0 words · 0 characters</span>
            <span>Formatting is saved as Markdown</span>
          </div>
        </div>

        <input
          id="inline-image-input"
          type="file"
          accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
          hidden
        />

        <p class="hint">
          Inline images are compressed to 200 KB or less without reducing
          their pixel dimensions. Add a meaningful image description when prompted.
        </p>

        <p class="hint">
          Formula notation can be inserted using the Formula button. Mathematical
          rendering on published pages will be added separately.
        </p>
      </div>

      <div class="form-actions">
        <button type="button" id="save-draft" class="secondary-button">
          Save draft
        </button>
        <button type="button" id="submit-review" class="primary-button">
          Submit for approval
        </button>
      </div>

      <p class="hint final-hint">
        Submitting for approval locks the submission while it is being
        reviewed. You can revise it if the administrator rejects it.
      </p>
    </form>

    <div id="loading-message" class="message">
      Checking your login and loading available authors and topics...
    </div>
  </section>
</Editorial>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Image from '@tiptap/extension-image';
  import { Table } from '@tiptap/extension-table';
  import { TableRow } from '@tiptap/extension-table';
  import { TableCell } from '@tiptap/extension-table';
  import { TableHeader } from '@tiptap/extension-table';
  import TextAlign from '@tiptap/extension-text-align';
  import Highlight from '@tiptap/extension-highlight';
  import Color from '@tiptap/extension-color';
  import { TextStyle } from '@tiptap/extension-text-style';
  import Subscript from '@tiptap/extension-subscript';
  import Superscript from '@tiptap/extension-superscript';
  import Placeholder from '@tiptap/extension-placeholder';
  import CharacterCount from '@tiptap/extension-character-count';
  import Underline from '@tiptap/extension-underline';
  import Link from '@tiptap/extension-link';
  import TurndownService from 'turndown';
  import { gfm } from 'turndown-plugin-gfm';

  const form = document.querySelector<HTMLFormElement>('#submission-form')!;
  const message = document.querySelector<HTMLDivElement>('#page-message')!;
  const loading = document.querySelector<HTMLDivElement>('#loading-message')!;

  const typeSelect = document.querySelector<HTMLSelectElement>('#content-type')!;
  const kindSelect = document.querySelector<HTMLSelectElement>('#kind')!;
  const topicSelect = document.querySelector<HTMLSelectElement>('#topic')!;
  const topicField = document.querySelector<HTMLDivElement>('#topic-field')!;
  const topicRequired = document.querySelector<HTMLSpanElement>('#topic-required')!;

  const authorSearch = document.querySelector<HTMLInputElement>('#author-search')!;
  const authorOptions = document.querySelector<HTMLDivElement>('#author-options')!;
  const selectedAuthorsBox = document.querySelector<HTMLDivElement>('#selected-authors')!;
  const authorCount = document.querySelector<HTMLParagraphElement>('#author-count')!;

  const coverInput = document.querySelector<HTMLInputElement>('#cover')!;
  const coverPreviewContainer = document.querySelector<HTMLDivElement>('#cover-preview-container')!;
  const coverPreview = document.querySelector<HTMLImageElement>('#cover-preview')!;
  const coverFileName = document.querySelector<HTMLParagraphElement>('#cover-file-name')!;
  const removeCoverButton = document.querySelector<HTMLButtonElement>('#remove-cover')!;

  const saveButton = document.querySelector<HTMLButtonElement>('#save-draft')!;
  const submitButton = document.querySelector<HTMLButtonElement>('#submit-review')!;

  const editorElement = document.querySelector<HTMLDivElement>('#rich-editor')!;
  const toolbar = document.querySelector<HTMLDivElement>('.editor-toolbar')!;
  const blockFormat = document.querySelector<HTMLSelectElement>('#block-format')!;
  const wordCount = document.querySelector<HTMLSpanElement>('#editor-word-count')!;
  const inlineImageInput = document.querySelector<HTMLInputElement>('#inline-image-input')!;

  type AuthorOption = { path: string; name: string };
  type TopicOption = { path: string; name: string };

  let availableAuthors: AuthorOption[] = [];
  let availableTopics: TopicOption[] = [];
  const selectedAuthorPaths = new Set<string>();

  let coverPreviewUrl = '';
  let processedCoverFile: File | null = null;
  let coverProcessing = false;
  let coverSelectionId = 0;

  let inlineImageProcessing = false;
  const MAX_IMAGE_SIZE = 200 * 1024;

  const kindOptions = {
    article: ['Article', 'Case summary', 'Commentary', 'Opinion', 'Book review'],
    guide: ['Research Guide', 'Writing Guide', 'Moot Court Guide', 'Academic Skills', 'Other']
  };

  const turndown = new TurndownService({
    headingStyle: 'atx',
    codeBlockStyle: 'fenced',
    bulletListMarker: '-',
    emDelimiter: '*',
    strongDelimiter: '**'
  });

  turndown.use(gfm);
  // Preserve text colours and background colours.
turndown.addRule('formattedText', {
  filter: (node) => {
    if (!(node instanceof HTMLElement)) return false;

    const style = node.getAttribute('style') || '';

    return (
      /(?:^|;)\s*color\s*:/i.test(style) ||
      /(?:^|;)\s*background-color\s*:/i.test(style)
    );
  },

  replacement: (content, node) => {
    const element = node as HTMLElement;
    const styles = element.getAttribute('style') || '';

    const color = styles.match(
      /(?:^|;)\s*color\s*:\s*([^;]+)/i
    )?.[1]?.trim();

    const background = styles.match(
      /(?:^|;)\s*background-color\s*:\s*([^;]+)/i
    )?.[1]?.trim();

    const safeColor = color && /^[#(),.%\w\s-]+$/.test(color)
      ? color
      : '';

    const safeBackground = background && /^[#(),.%\w\s-]+$/.test(background)
      ? background
      : '';

    const declarations = [
      safeColor ? `color: ${safeColor}` : '',
      safeBackground ? `background-color: ${safeBackground}` : ''
    ].filter(Boolean);

    if (!declarations.length) return content;

    return `<span style="${declarations.join('; ')}">${content}</span>`;
  }
});
  turndown.addRule('underline', {
    filter: ['u'],
    replacement: (content) => `<u>${content}</u>`
  });

  turndown.addRule('subscript', {
    filter: ['sub'],
    replacement: (content) => `<sub>${content}</sub>`
  });

  turndown.addRule('superscript', {
    filter: ['sup'],
    replacement: (content) => `<sup>${content}</sup>`
  });

  turndown.addRule('highlight', {
    filter: ['mark'],
    replacement: (content) => `<mark>${content}</mark>`
  });

  turndown.addRule('image', {
    filter: 'img',
    replacement: (_content, node) => {
      const image = node as HTMLImageElement;
      const alt = image.getAttribute('alt') || '';
      const src = image.getAttribute('src') || '';
      const title = image.getAttribute('title');

      if (!src) return '';

      const safeAlt = alt.replace(/([\\[\]])/g, '\\$1');
      const safeTitle = title ? ` "${title.replace(/"/g, '\\"')}"` : '';

      return `![${safeAlt}](${src}${safeTitle})`;
    }
  });

  const editor = new Editor({
  element: editorElement,
  extensions: [
    StarterKit.configure({
      heading: { levels: [1, 2, 3] }
    }),

    Underline,

    Link.configure({
      openOnClick: false,
      autolink: true,
      linkOnPaste: true,
      HTMLAttributes: {
        target: '_blank',
        rel: 'noopener noreferrer'
      }
    }),

    Image.configure({
      inline: false,
      allowBase64: false
    }),

    Table.configure({
      resizable: true
    }),
    TableRow,
    TableHeader,
    TableCell,

    TextAlign.configure({
      types: ['heading', 'paragraph']
    }),

    Highlight.configure({
      multicolor: true
    }),

    TextStyle,
    Color,
    Subscript,
    Superscript,

    Placeholder.configure({
      placeholder: 'Start writing your article or guide here...'
    }),

    CharacterCount
  ],

  content: '<p></p>',

  editorProps: {
  transformPastedHTML(html) {
    const doc = new DOMParser().parseFromString(html, 'text/html');

    // Remove unnecessary Microsoft Word and Google Docs content.
    doc.querySelectorAll(
      'script, style, meta, link, title, xml'
    ).forEach((element) => element.remove());

    // Remove Microsoft Word's empty paragraph markers.
    doc.querySelectorAll('o\\:p').forEach((element) => {
      element.replaceWith(...Array.from(element.childNodes));
    });

    // Keep useful paragraph and text formatting.
    doc.querySelectorAll<HTMLElement>('[style]').forEach((element) => {
      const style = element.style;

      const allowedStyles = [
        'color',
        'background-color',
        'text-align',
        'font-weight',
        'font-style',
        'text-decoration'
      ];

      const preservedStyles = allowedStyles
        .map((property) => {
          const value = style.getPropertyValue(property);
          return value ? `${property}: ${value}` : '';
        })
        .filter(Boolean);

      if (preservedStyles.length) {
        element.setAttribute('style', preservedStyles.join('; '));
      } else {
        element.removeAttribute('style');
      }
    });

    // Preserve valid hyperlinks.
    doc.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      const href = link.getAttribute('href');

      if (!href) return;

      try {
        const url = new URL(href, window.location.origin);

        if (!['http:', 'https:', 'mailto:'].includes(url.protocol)) {
          link.removeAttribute('href');
        }
      } catch {
        link.removeAttribute('href');
      }
    });

    return doc.body.innerHTML;
  }
},

  onUpdate: ({ editor }) => {
    updateWordCount();
    updateToolbarState();
  },

  onSelectionUpdate: () => updateToolbarState()
});

  function showMessage(text: string, type: 'success' | 'error') {
    message.textContent = text;
    message.className = `message ${type}`;
    message.hidden = false;
  }

  function updateWordCount() {
    const words = editor.storage.characterCount.words();
    const characters = editor.storage.characterCount.characters();

    wordCount.textContent = `${words} words · ${characters} characters`;
  }

  function updateToolbarState() {
    toolbar.querySelectorAll<HTMLButtonElement>('button[data-action]').forEach((button) => {
      const action = button.dataset.action;

      const active =
        (action === 'bold' && editor.isActive('bold')) ||
        (action === 'italic' && editor.isActive('italic')) ||
        (action === 'underline' && editor.isActive('underline')) ||
        (action === 'strike' && editor.isActive('strike')) ||
        (action === 'highlight' && editor.isActive('highlight')) ||
        (action === 'bullet' && editor.isActive('bulletList')) ||
        (action === 'ordered' && editor.isActive('orderedList')) ||
        (action === 'quote' && editor.isActive('blockquote')) ||
        (action === 'code' && editor.isActive('codeBlock'));

      button.classList.toggle('active', Boolean(active));
    });

    const heading = editor.getAttributes('heading').level;

    if (editor.isActive('heading') && [1, 2, 3].includes(heading)) {
      blockFormat.value = `h${heading}`;
    } else {
      blockFormat.value = 'paragraph';
    }
  }

  function updateKindOptions() {
    const type = typeSelect.value as 'article' | 'guide';

    kindSelect.replaceChildren();

    kindOptions[type].forEach((kind) => {
      const option = document.createElement('option');
      option.value = kind;
      option.textContent = kind;
      kindSelect.append(option);
    });

    const isArticle = type === 'article';

    topicSelect.required = isArticle;
    topicRequired.hidden = !isArticle;
    topicField.hidden = !isArticle;

    if (!isArticle) topicSelect.value = '';
  }

  function getSelectedAuthors(): string[] {
    return Array.from(selectedAuthorPaths);
  }

  function updateAuthorCount() {
    const count = selectedAuthorPaths.size;

    authorCount.textContent = count === 1
      ? '1 author selected.'
      : `${count} authors selected.`;

    authorSearch.setCustomValidity(
      count === 0 ? 'Please select at least one author.' : ''
    );
  }

  function renderSelectedAuthors() {
    selectedAuthorsBox.replaceChildren();

    const selected = availableAuthors.filter((author) =>
      selectedAuthorPaths.has(author.path)
    );

    if (selected.length === 0) {
      const empty = document.createElement('span');
      empty.className = 'hint';
      empty.textContent = 'No authors selected yet.';
      selectedAuthorsBox.append(empty);
      return;
    }

    selected.forEach((author) => {
      const tag = document.createElement('span');
      tag.className = 'author-tag';

      const name = document.createElement('span');
      name.textContent = author.name.trim();

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.setAttribute('aria-label', `Remove ${author.name}`);

      remove.addEventListener('click', () => {
        selectedAuthorPaths.delete(author.path);
        renderSelectedAuthors();
        renderAuthors();
        updateAuthorCount();
      });

      tag.append(name, remove);
      selectedAuthorsBox.append(tag);
    });
  }

  function renderAuthors() {
    const searchTerm = authorSearch.value.trim().toLowerCase();

    authorOptions.replaceChildren();

    const filteredAuthors = availableAuthors.filter((author) =>
      author.name.toLowerCase().includes(searchTerm)
    );

    if (filteredAuthors.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'hint';
      empty.textContent = 'No matching authors found.';
      authorOptions.append(empty);
      return;
    }

    filteredAuthors.forEach((author) => {
      const label = document.createElement('label');
      label.className = 'author-option';

      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.name = 'authors';
      checkbox.value = author.path;
      checkbox.checked = selectedAuthorPaths.has(author.path);

      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          selectedAuthorPaths.add(author.path);
        } else {
          selectedAuthorPaths.delete(author.path);
        }

        renderSelectedAuthors();
        updateAuthorCount();
      });

      const name = document.createElement('span');
      name.textContent = author.name.trim();

      label.append(checkbox, name);
      authorOptions.append(label);
    });
  }

  function loadTopics() {
    topicSelect.replaceChildren();

    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select a topic';
    topicSelect.append(placeholder);

    availableTopics.forEach((topic) => {
      const option = document.createElement('option');
      option.value = topic.path;
      option.textContent = topic.name.trim();
      topicSelect.append(option);
    });
  }

  async function loadSubmissionOptions() {
    const response = await fetch('/api/submissions/options', {
      credentials: 'same-origin',
      cache: 'no-store'
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(result.message || 'Could not load authors and topics.');
    }

    availableAuthors = Array.isArray(result.authors)
      ? result.authors.filter((item: AuthorOption) => item.path && item.name)
      : [];

    availableTopics = Array.isArray(result.topics)
      ? result.topics.filter((item: TopicOption) => item.path && item.name)
      : [];

    if (availableAuthors.length === 0) {
      throw new Error('No authors are currently available.');
    }

    renderAuthors();
    renderSelectedAuthors();
    loadTopics();
  }

  async function checkSession() {
    try {
      const response = await fetch('/api/auth/me', {
        credentials: 'same-origin',
        cache: 'no-store'
      });

      if (!response.ok) {
        window.location.replace('/editorial');
        return;
      }

      const result = await response.json();

      if (!result.ok) {
        window.location.replace('/editorial');
        return;
      }

      await loadSubmissionOptions();

      loading.hidden = true;
      form.hidden = false;
      updateAuthorCount();
      updateWordCount();
    } catch (error) {
      loading.textContent = error instanceof Error
        ? error.message
        : 'Unable to load the submission form. Please refresh the page.';
    }
  }

  function showCoverPreview(file: File) {
    if (coverPreviewUrl) URL.revokeObjectURL(coverPreviewUrl);

    coverPreviewUrl = URL.createObjectURL(file);
    coverPreview.src = coverPreviewUrl;
    coverFileName.textContent = file.name;
    coverPreviewContainer.hidden = false;
  }

  function clearCover() {
    coverSelectionId++;

    if (coverPreviewUrl) {
      URL.revokeObjectURL(coverPreviewUrl);
      coverPreviewUrl = '';
    }

    coverInput.value = '';
    processedCoverFile = null;
    coverProcessing = false;

    coverPreview.removeAttribute('src');
    coverPreviewContainer.hidden = true;
    coverFileName.textContent = '';
  }

  function formatFileSize(bytes: number): string {
    return `${(bytes / 1024).toFixed(1)} KB`;
  }

  async function compressImage(file: File): Promise<File> {
    if (file.size <= MAX_IMAGE_SIZE) return file;

    if (!('createImageBitmap' in window)) {
      throw new Error('Your browser cannot compress this image. Please use a newer browser.');
    }

    let image: ImageBitmap;

    try {
      image = await createImageBitmap(file);
    } catch {
      throw new Error('The selected image could not be opened.');
    }

    try {
      const canvas = document.createElement('canvas');
      canvas.width = image.width;
      canvas.height = image.height;

      const context = canvas.getContext('2d');

      if (!context) throw new Error('Image compression could not be started.');

      context.drawImage(image, 0, 0);

      const qualities = [
        0.92, 0.88, 0.84, 0.80, 0.76, 0.72, 0.68,
        0.64, 0.60, 0.56, 0.52, 0.48, 0.44, 0.40
      ];

      for (const quality of qualities) {
        const blob = await new Promise<Blob | null>((resolve) => {
          canvas.toBlob(resolve, 'image/webp', quality);
        });

        if (blob && blob.size <= MAX_IMAGE_SIZE) {
          const name = file.name.replace(/\.[^.]+$/, '');

          return new File([blob], `${name}.webp`, {
            type: 'image/webp',
            lastModified: Date.now()
          });
        }
      }

      throw new Error(
        'This image cannot be compressed below 200 KB without reducing its dimensions. Please choose another image.'
      );
    } finally {
      image.close();
    }
  }

  async function uploadCover(): Promise<string> {
    if (!processedCoverFile) return '';

    if (processedCoverFile.size > MAX_IMAGE_SIZE) {
      throw new Error('The compressed cover image is still larger than 200 KB.');
    }

    const formData = new FormData();
    formData.append('cover', processedCoverFile);

    const response = await fetch('/api/submissions/upload-cover', {
      method: 'POST',
      credentials: 'same-origin',
      cache: 'no-store',
      body: formData
    });

    const result = await response.json();

    if (!response.ok || !result.ok || !result.cover) {
      throw new Error(result.message || 'The cover image could not be uploaded.');
    }

    return result.cover;
  }

  async function uploadInlineImage(file: File): Promise<string> {
    const processedFile = await compressImage(file);

    if (processedFile.size > MAX_IMAGE_SIZE) {
      throw new Error('The image could not be compressed below 200 KB.');
    }

    const formData = new FormData();
    formData.append('image', processedFile);

    const response = await fetch('/api/submissions/upload-inline-image', {
      method: 'POST',
      credentials: 'same-origin',
      cache: 'no-store',
      body: formData
    });

    const result = await response.json();

    if (!response.ok || !result.ok || !result.image) {
      throw new Error(result.message || 'The inline image could not be uploaded.');
    }

    return result.image;
  }

  async function insertInlineImage(file: File) {
    if (inlineImageProcessing) return;

    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];

    if (!allowedTypes.includes(file.type)) {
      showMessage('Please choose a JPEG, PNG or WebP image.', 'error');
      return;
    }

    const description = window.prompt(
      'Write a short image description for screen readers:'
    );

    if (description === null) return;

    inlineImageProcessing = true;

    try {
      showMessage('Preparing and uploading your inline image...', 'success');

      const imagePath = await uploadInlineImage(file);

      editor.chain().focus().setImage({
        src: imagePath,
        alt: description.trim()
      }).run();

      showMessage('Image inserted into your article.', 'success');
    } catch (error) {
      showMessage(
        error instanceof Error ? error.message : 'Image upload failed.',
        'error'
      );
    } finally {
      inlineImageProcessing = false;
      inlineImageInput.value = '';
    }
  }

  function addLink() {
    const previous = editor.getAttributes('link').href || '';
    const url = window.prompt('Enter the link address:', previous);

    if (url === null) return;

    if (!url.trim()) {
      editor.chain().focus().extendMarkRange('link').unsetLink().run();
      return;
    }

    try {
      const parsed = new URL(url.trim());

      if (!['http:', 'https:', 'mailto:'].includes(parsed.protocol)) {
        throw new Error('Unsupported link type.');
      }

      editor.chain().focus().extendMarkRange('link')
        .setLink({ href: url.trim() }).run();
    } catch {
      showMessage('Please enter a valid web address or email link.', 'error');
    }
  }

  function insertFormula() {
    const formula = window.prompt(
      'Enter your formula. Example: E = mc^2'
    );

    if (formula === null || !formula.trim()) return;

    editor.chain().focus().insertContent(` $${formula.trim()}$ `).run();
  }

  function runToolbarAction(action: string) {
    const chain = editor.chain().focus();

    switch (action) {
      case 'undo': chain.undo().run(); break;
      case 'redo': chain.redo().run(); break;
      case 'bold': chain.toggleBold().run(); break;
      case 'italic': chain.toggleItalic().run(); break;
      case 'underline': chain.toggleUnderline().run(); break;
      case 'strike': chain.toggleStrike().run(); break;
      case 'highlight': chain.toggleHighlight().run(); break;
      case 'bullet': chain.toggleBulletList().run(); break;
      case 'ordered': chain.toggleOrderedList().run(); break;
      case 'quote': chain.toggleBlockquote().run(); break;
      case 'code': chain.toggleCodeBlock().run(); break;
      case 'link': addLink(); break;
      case 'image': inlineImageInput.click(); break;
      case 'table':
        chain.insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
        break;
      case 'formula': insertFormula(); break;
      case 'rule': chain.setHorizontalRule().run(); break;
    }
  }

  toolbar.addEventListener('mousedown', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('button')) {
      event.preventDefault();
    }
  });

  toolbar.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const button = target.closest<HTMLButtonElement>('button[data-action]');

    if (!button) return;

    runToolbarAction(button.dataset.action || '');
  });

  blockFormat.addEventListener('change', () => {
    const value = blockFormat.value;
    const chain = editor.chain().focus();

    if (value === 'paragraph') {
      chain.setParagraph().run();
    } else {
      chain.setHeading({
        level: Number(value.substring(1)) as 1 | 2 | 3
      }).run();
    }
  });

  inlineImageInput.addEventListener('change', () => {
    const file = inlineImageInput.files?.[0];

    if (file) insertInlineImage(file);
  });

  editorElement.addEventListener('dragover', (event) => {
    event.preventDefault();
  });

  editorElement.addEventListener('drop', (event) => {
    const files = Array.from(event.dataTransfer?.files || []);
    const imageFile = files.find((file) => file.type.startsWith('image/'));

    if (imageFile) {
      event.preventDefault();
      insertInlineImage(imageFile);
    }
  });

  editorElement.addEventListener('paste', (event) => {
    const files = Array.from(event.clipboardData?.files || []);
    const imageFile = files.find((file) => file.type.startsWith('image/'));

    if (imageFile) {
      event.preventDefault();
      insertInlineImage(imageFile);
    }
  });

  function getSubmissionData(status: 'draft' | 'pending', cover: string) {
    const keywords = (
      document.querySelector<HTMLInputElement>('#keywords')!.value
    )
      .split(',')
      .map((item) => item.trim())
      .filter(Boolean);

    const markdownBody = turndown.turndown(editor.getHTML()).trim();

    return {
      contentType: typeSelect.value,
      title: document.querySelector<HTMLInputElement>('#title')!.value.trim(),
      summary: document.querySelector<HTMLTextAreaElement>('#summary')!.value.trim(),
      kind: kindSelect.value,
      date: document.querySelector<HTMLInputElement>('#date')!.value,
      authors: getSelectedAuthors(),
      topic: typeSelect.value === 'article' ? topicSelect.value : '',
      keywords,
      body: markdownBody,
      cover,
      coverAlt: document.querySelector<HTMLInputElement>('#cover-alt')!.value.trim(),
      coverCredit: document.querySelector<HTMLInputElement>('#cover-credit')!.value.trim(),
      featured: document.querySelector<HTMLInputElement>('#featured')!.checked,
      peerReviewed: document.querySelector<HTMLInputElement>('#peer-reviewed')!.checked,
      status
    };
  }

  async function saveSubmission(status: 'draft' | 'pending') {
    updateAuthorCount();

    if (!form.reportValidity()) return;

    if (editor.isEmpty) {
      showMessage('Please write the main content before saving.', 'error');
      editor.commands.focus();
      return;
    }

    if (coverProcessing) {
      showMessage('Please wait until the cover image has finished processing.', 'error');
      return;
    }

    if (coverInput.files?.[0] && !processedCoverFile) {
      showMessage('Please select the cover image again.', 'error');
      return;
    }

    if (inlineImageProcessing) {
      showMessage('Please wait until the inline image upload has finished.', 'error');
      return;
    }

    saveButton.disabled = true;
    submitButton.disabled = true;

    saveButton.textContent =
      status === 'draft' ? 'Saving...' : 'Please wait...';

    submitButton.textContent =
      status === 'pending' ? 'Submitting...' : 'Please wait...';

    message.hidden = true;

    try {
      const cover = await uploadCover();

      const response = await fetch('/api/submissions/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        cache: 'no-store',
        body: JSON.stringify(getSubmissionData(status, cover))
      });

      const result = await response.json();

      if (!response.ok || !result.ok) {
        throw new Error(result.message || 'The submission could not be saved.');
      }

      showMessage(
        status === 'draft'
          ? 'Your draft has been saved successfully.'
          : 'Your submission has been sent to the administrator for review.',
        'success'
      );

      form.reset();
      selectedAuthorPaths.clear();
      authorSearch.value = '';
      clearCover();
      editor.commands.clearContent();

      renderAuthors();
      renderSelectedAuthors();
      updateKindOptions();
      updateAuthorCount();
      updateWordCount();

      const dateInput = document.querySelector<HTMLInputElement>('#date')!;
      dateInput.value = new Date().toISOString().slice(0, 10);
    } catch (error) {
      showMessage(
        error instanceof Error ? error.message : 'Something went wrong. Please try again.',
        'error'
      );
    } finally {
      saveButton.disabled = false;
      submitButton.disabled = false;
      saveButton.textContent = 'Save draft';
      submitButton.textContent = 'Submit for approval';
    }
  }

  typeSelect.addEventListener('change', updateKindOptions);
  authorSearch.addEventListener('input', renderAuthors);

  coverInput.addEventListener('change', async () => {
    const file = coverInput.files?.[0];
    const selectionId = ++coverSelectionId;

    processedCoverFile = null;

    if (!file) {
      clearCover();
      return;
    }

    if (!['image/jpeg', 'image/png', 'image/webp'].includes(file.type)) {
      clearCover();
      showMessage('Please choose a JPEG, PNG or WebP image.', 'error');
      return;
    }

    coverProcessing = true;
    message.hidden = true;
    coverFileName.textContent = 'Preparing image...';
    coverPreviewContainer.hidden = false;
    coverPreview.removeAttribute('src');

    try {
      const processedFile = await compressImage(file);

      if (
        selectionId !== coverSelectionId ||
        coverInput.files?.[0] !== file
      ) return;

      processedCoverFile = processedFile;
      showCoverPreview(processedFile);

      showMessage(
        file.size > MAX_IMAGE_SIZE
          ? `Image compressed. Original: ${formatFileSize(file.size)}. Compressed: ${formatFileSize(processedFile.size)}. Dimensions preserved.`
          : `Image ready to upload (${formatFileSize(processedFile.size)}).`,
        'success'
      );
    } catch (error) {
      if (selectionId === coverSelectionId) {
        clearCover();
        showMessage(
          error instanceof Error ? error.message : 'The image could not be processed.',
          'error'
        );
      }
    } finally {
      if (selectionId === coverSelectionId) coverProcessing = false;
    }
  });

  removeCoverButton.addEventListener('click', clearCover);

  saveButton.addEventListener('click', () => saveSubmission('draft'));
  submitButton.addEventListener('click', () => saveSubmission('pending'));

  updateKindOptions();

  const dateInput = document.querySelector<HTMLInputElement>('#date')!;
  dateInput.value = new Date().toISOString().slice(0, 10);

  checkSession();
</script>

