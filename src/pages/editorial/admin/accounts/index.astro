
---
import Editorial from "../../../../layouts/Editorial.astro";

const description = "Manage DraftLaw Research editorial accounts and permissions.";
---

<Editorial title="Editor Accounts" description={description}>
  <div class="wrap accounts-page">
    <header class="page-heading">
      <div>
        <p class="eyebrow">03 / TEAM</p>
        <h1>Editor Accounts</h1>
        <p class="intro">
          Create accounts and manage access to the editorial portal.
        </p>
      </div>

      <a class="back-button" href="/editorial/dashboard/">
        ← Dashboard
      </a>
    </header>

    <p id="page-status" class="status" role="status">
      Verifying your access...
    </p>

    <div id="accounts-workspace" hidden>
      <section id="create-section" class="panel" hidden>
        <div class="panel-heading">
          <div>
            <p class="eyebrow">NEW ACCOUNT</p>
            <h2>Create an account</h2>
            <p>Create an editor or moderator account.</p>
          </div>
        </div>

        <form id="create-form">
          <div class="form-grid">
            <label>
              Username
              <input
                id="new-username"
                name="username"
                type="text"
                minlength="4"
                maxlength="30"
                pattern="[A-Za-z0-9._-]{4,30}"
                autocomplete="off"
                required
              />
              <small>
                4–30 characters. Letters, numbers, dots, underscores and hyphens.
              </small>
            </label>

            <label>
              Temporary password
              <input
                id="new-password"
                name="password"
                type="password"
                minlength="12"
                maxlength="128"
                autocomplete="new-password"
                required
              />
              <small>
                At least 12 characters. Share it securely with the account holder.
              </small>
            </label>

            <label>
              Account type
              <select id="new-role" name="role" required>
                <option value="editor">Editor</option>
                <option value="moderator">Moderator</option>
              </select>
            </label>
          </div>

          <p id="create-message" class="form-message" role="status"></p>

          <button type="submit" id="create-button" class="primary-button">
            Create account
          </button>
        </form>
      </section>

      <section class="panel">
        <div class="panel-heading">
          <div>
            <p class="eyebrow">TEAM DIRECTORY</p>
            <h2>Accounts and access</h2>
            <p id="access-description">
              Review accounts and manage their content permissions.
            </p>
          </div>

          <button type="button" id="refresh-button" class="secondary-button">
            Refresh
          </button>
        </div>

        <div id="account-list" class="account-list"></div>
      </section>

      <p class="security-note">
        Permission changes take effect when saved. Administrators retain
        access to all content sections. Moderators can manage only the
        sections specifically delegated to them.
      </p>
    </div>
  </div>
</Editorial>

<script>
  const SECTION_LABELS = {
    articles: "Articles",
    guides: "Guidelines and Guidance",
    authors: "Authors",
    topics: "Topics",
    team: "Team Members",
    "student-collaborators": "Student Collaborators",
    newsletter: "Newsletter Items",
    programs: "Programs",
    announcements: "Program Announcements",
    submit: "Write with Us Rules",
    "most-read": "Most Read List"
  };

  const MAX_PROFILE_IMAGE_SIZE = 200 * 1024;
  const $ = selector => document.querySelector(selector);

  let currentRole = null;
  let sections = [];
  let managedSections = [];
  let users = [];
  let permissions = [];

  async function requestJson(url, options = {}) {
    const response = await fetch(url, {
      credentials: "same-origin",
      cache: "no-store",
      ...options
    });

    const result = await response.json();

    if (!response.ok || !result.ok) {
      throw new Error(
        result.message || "The request could not be completed."
      );
    }

    return result;
  }

  function showStatus(message, isError = false) {
    const status = $("#page-status");
    status.textContent = message;
    status.hidden = false;
    status.classList.toggle("error", isError);
  }

  function hasPermission(userId, sectionKey) {
    return permissions.some(permission =>
      permission.user_id === userId &&
      permission.section_key === sectionKey
    );
  }

  async function loadPage() {
    try {
      const auth = await requestJson("/api/auth/me");

      currentRole = auth.user.role;

      if (!["admin", "moderator"].includes(currentRole)) {
        window.location.replace("/editorial/dashboard/");
        return;
      }

      const result = await requestJson("/api/admin/permissions");

      sections = result.sections || [];
      managedSections = result.managedSections || [];

      // Hide anonymised account records from the active directory.
      users = (result.users || []).filter(
        user => !user.username.startsWith("deleted-")
      );

      permissions = result.permissions || [];

      if (currentRole === "admin") {
        $("#create-section").hidden = false;

        $("#access-description").textContent =
          "Manage editor and moderator accounts, content access and delegated authority.";
      } else {
        $("#access-description").textContent =
          "Manage editor access to the sections delegated to you.";
      }

      $("#accounts-workspace").hidden = false;
      $("#page-status").hidden = true;

      renderAccounts();

    } catch (error) {
      showStatus(error.message, true);
    }
  }

  function createElement(tag, className, text) {
    const element = document.createElement(tag);

    if (className) {
      element.className = className;
    }

    if (text !== undefined) {
      element.textContent = text;
    }

    return element;
  }

  async function compressProfileImage(file) {
    if (!file || !file.type.startsWith("image/")) {
      throw new Error("Please select a valid image.");
    }

    if (file.size <= MAX_PROFILE_IMAGE_SIZE) {
      return file;
    }

    if (!("createImageBitmap" in window)) {
      throw new Error(
        "Your browser does not support automatic image compression. Please use a smaller picture."
      );
    }

    let bitmap;

    try {
      bitmap = await createImageBitmap(file);

      const canvas = document.createElement("canvas");
      const context = canvas.getContext("2d");

      if (!context) {
        throw new Error("Could not prepare the picture for compression.");
      }

      const outputType = file.type === "image/jpeg"
        ? "image/jpeg"
        : "image/webp";

      const qualities = [
        0.94, 0.90, 0.86, 0.82, 0.78, 0.74, 0.70
      ];

      let width = bitmap.width;
      let height = bitmap.height;

      async function createCompressedBlob(quality) {
        canvas.width = width;
        canvas.height = height;

        context.clearRect(0, 0, width, height);
        context.drawImage(bitmap, 0, 0, width, height);

        return new Promise((resolve, reject) => {
          canvas.toBlob(
            blob => {
              if (blob) {
                resolve(blob);
              } else {
                reject(new Error("Picture compression failed."));
              }
            },
            outputType,
            quality
          );
        });
      }

      for (const quality of qualities) {
        const blob = await createCompressedBlob(quality);

        if (blob.size <= MAX_PROFILE_IMAGE_SIZE) {
          const extension =
            outputType === "image/jpeg" ? "jpg" : "webp";

          return new File(
            [blob],
            `profile-picture.${extension}`,
            {
              type: outputType,
              lastModified: Date.now()
            }
          );
        }
      }

      for (let attempt = 0; attempt < 10; attempt++) {
        width = Math.max(1, Math.round(width * 0.9));
        height = Math.max(1, Math.round(height * 0.9));

        for (const quality of [0.88, 0.84, 0.80, 0.76, 0.72]) {
          const blob = await createCompressedBlob(quality);

          if (blob.size <= MAX_PROFILE_IMAGE_SIZE) {
            const extension =
              outputType === "image/jpeg" ? "jpg" : "webp";

            return new File(
              [blob],
              `profile-picture.${extension}`,
              {
                type: outputType,
                lastModified: Date.now()
              }
            );
          }
        }
      }

      throw new Error(
        "This picture could not be compressed below 200 KB. Please choose another picture."
      );

    } finally {
      if (bitmap) {
        bitmap.close();
      }
    }
  }

  function renderAccounts() {
    const list = $("#account-list");
    list.replaceChildren();

    if (users.length === 0) {
      list.append(
        createElement(
          "p",
          "empty-state",
          "No editor or moderator accounts have been created yet."
        )
      );
      return;
    }

    const sortedUsers = [...users].sort((a, b) => {
      if (a.role !== b.role) {
        return a.role === "moderator" ? -1 : 1;
      }

      return a.username.localeCompare(b.username);
    });

    for (const user of sortedUsers) {
      list.append(renderAccount(user));
    }
  }

  function renderAccount(user) {
    const card = createElement("article", "account-card");

    const heading = createElement("div", "account-heading");
    const profile = createElement("div", "editor-profile");

    const avatar = document.createElement("img");
    avatar.className = "editor-avatar";
    avatar.alt = user.display_name || user.username;
    avatar.src =
      user.profile_image_url || "/images/default-avatar.png";

    avatar.onerror = () => {
      avatar.style.display = "none";
    };

    const identity = createElement("div", "account-identity");

    const name = createElement(
      "h3",
      "",
      user.display_name || user.username
    );

    const username = createElement(
      "span",
      "editor-username",
      `@${user.username}`
    );

    const role = createElement(
      "span",
      "role-label",
      user.role === "moderator" ? "Moderator" : "Editor"
    );

    identity.append(name, username, role);
    profile.append(avatar, identity);

    const status = createElement(
      "span",
      Number(user.is_active) === 1
        ? "account-status active"
        : "account-status inactive",
      Number(user.is_active) === 1 ? "Active" : "Inactive"
    );

    heading.append(profile, status);
    card.append(heading);

    // Administrator-only profile editor.
    if (currentRole === "admin") {
      const editor = createElement("div", "profile-editor");

      const editorHeading = createElement(
        "p",
        "permission-heading",
        "Editor profile information"
      );

      const nameLabel = createElement(
        "label",
        "profile-field",
        "Actual name"
      );

      const nameInput = document.createElement("input");
      nameInput.type = "text";
      nameInput.maxLength = 80;
      nameInput.value = user.display_name || "";
      nameInput.placeholder = "Enter the editor's actual name";

      nameLabel.append(nameInput);

      const imageLabel = createElement(
        "label",
        "profile-field",
        "Profile picture"
      );

      const imageInput = document.createElement("input");
      imageInput.type = "file";
      imageInput.accept = "image/jpeg,image/png,image/webp";

      imageLabel.append(imageInput);

      const removeLabel = createElement(
        "label",
        "profile-remove"
      );

      const removeImage = document.createElement("input");
      removeImage.type = "checkbox";

      const removeText = createElement(
        "span",
        "",
        "Remove current profile picture"
      );

      removeLabel.append(removeImage, removeText);

      const saveButton = createElement(
        "button",
        "secondary-button",
        "Save profile"
      );

      saveButton.type = "button";

      saveButton.addEventListener("click", async () => {
        saveButton.disabled = true;
        saveButton.textContent = "Saving...";

        try {
          let profileImageUrl = user.profile_image_url || null;

          const selectedFile = imageInput.files[0];

          if (selectedFile) {
            showStatus("Preparing profile picture...");

            const compressedFile =
              await compressProfileImage(selectedFile);

            const formData = new FormData();
            formData.append("image", compressedFile);

            showStatus(
              compressedFile.size < selectedFile.size
                ? `Picture compressed to ${(compressedFile.size / 1024).toFixed(1)} KB. Uploading...`
                : "Uploading profile picture..."
            );

            const upload = await requestJson(
              "/api/admin/upload-profile-image",
              {
                method: "POST",
                body: formData
              }
            );

            profileImageUrl = upload.image;

          } else if (removeImage.checked) {
            profileImageUrl = null;
          }

          await requestJson("/api/admin/accounts", {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              action: "update_profile",
              userId: user.id,
              displayName: nameInput.value,
              profileImageUrl
            })
          });

          showStatus(
            `Profile updated successfully for ${user.username}.`
          );

          await refreshPermissions();

        } catch (error) {
          showStatus(error.message, true);

        } finally {
          saveButton.disabled = false;
          saveButton.textContent = "Save profile";
        }
      });

      editor.append(
        editorHeading,
        nameLabel,
        imageLabel,
        removeLabel,
        saveButton
      );

      card.append(editor);
    }

    // Content permissions.
    const visibleSections = currentRole === "admin"
      ? sections
      : managedSections;

    card.append(
      createElement(
        "p",
        "permission-heading",
        "Content access"
      )
    );

    if (visibleSections.length === 0) {
      card.append(
        createElement(
          "p",
          "empty-state",
          "No content sections have been delegated to you."
        )
      );
    }

    const grid = createElement("div", "permission-grid");

    for (const section of visibleSections) {
      grid.append(
        createPermissionControl(
          user,
          section,
          SECTION_LABELS[section] || section,
          false
        )
      );
    }

    card.append(grid);

    // Moderator management permissions.
    if (currentRole === "admin" && user.role === "moderator") {
      card.append(
        createElement(
          "p",
          "permission-heading management-heading",
          "Permission-management authority"
        )
      );

      const managementGrid = createElement(
        "div",
        "permission-grid"
      );

      for (const section of sections) {
        managementGrid.append(
          createPermissionControl(
            user,
            `manage:${section}`,
            `Manage ${SECTION_LABELS[section] || section} access`,
            true
          )
        );
      }

      card.append(managementGrid);
    }

    // Administrator-only account actions.
    if (currentRole === "admin") {
      const actions = createElement("div", "account-actions");

      const toggle = createElement(
        "button",
        "secondary-button",
        Number(user.is_active) === 1
          ? "Deactivate account"
          : "Activate account"
      );

      toggle.type = "button";

      toggle.addEventListener("click", () => {
        updateAccountStatus(user);
      });

      const deleteButton = createElement(
        "button",
        "danger-button",
        "Delete account"
      );

      deleteButton.type = "button";

      deleteButton.addEventListener("click", () => {
        deleteAccount(user, deleteButton);
      });

      actions.append(toggle, deleteButton);
      card.append(actions);
    }

    return card;
  }

  function createPermissionControl(
    user,
    permissionKey,
    label,
    managementPermission
  ) {
    const wrapper = createElement(
      "label",
      "permission-control"
    );

    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.checked = hasPermission(user.id, permissionKey);
    checkbox.disabled = Number(user.is_active) !== 1;

    const labelText = createElement("span", "", label);

    checkbox.addEventListener("change", async () => {
      checkbox.disabled = true;

      try {
        await requestJson("/api/admin/permissions", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            userId: user.id,
            sectionKey: permissionKey,
            enabled: checkbox.checked
          })
        });

        showStatus(
          `${label} permission ${checkbox.checked ? "granted" : "revoked"} for ${user.username}.`
        );

        await refreshPermissions();

      } catch (error) {
        checkbox.checked = !checkbox.checked;
        showStatus(error.message, true);
        checkbox.disabled = false;
      }
    });

    wrapper.append(checkbox, labelText);

    if (managementPermission) {
      wrapper.classList.add("management-control");
    }

    return wrapper;
  }

  async function refreshPermissions() {
    const result = await requestJson("/api/admin/permissions");

    sections = result.sections || [];
    managedSections = result.managedSections || [];

    users = (result.users || []).filter(
      user => !user.username.startsWith("deleted-")
    );

    permissions = result.permissions || [];

    renderAccounts();
  }

  async function updateAccountStatus(user) {
    const currentlyActive = Number(user.is_active) === 1;

    const confirmed = window.confirm(
      currentlyActive
        ? `Deactivate the account "${user.username}"? They will be signed out.`
        : `Activate the account "${user.username}"?`
    );

    if (!confirmed) return;

    try {
      await requestJson("/api/admin/accounts", {
        method: "PATCH",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          userId: user.id,
          active: !currentlyActive
        })
      });

      showStatus(
        `Account ${currentlyActive ? "deactivated" : "activated"} successfully.`
      );

      await refreshPermissions();

    } catch (error) {
      showStatus(error.message, true);
    }
  }

  async function deleteAccount(user, button) {
    const firstConfirmation = window.confirm(
      `PERMANENT ACCOUNT REMOVAL\n\n` +
      `You are about to remove "${user.username}" (${user.role}).\n\n` +
      `Their account access, profile information, sessions and section permissions will be removed.\n\n` +
      `Their submitted articles, published content and activity history will be preserved.\n\n` +
      `This action cannot be undone. Continue?`
    );

    if (!firstConfirmation) return;

    const typedUsername = window.prompt(
      `To confirm permanent removal, type this username exactly:\n\n${user.username}`
    );

    if (typedUsername !== user.username) {
      showStatus(
        "Account removal cancelled. The username confirmation did not match.",
        true
      );
      return;
    }

    button.disabled = true;
    button.textContent = "Removing...";

    try {
      const result = await requestJson(
        "/api/admin/accounts",
        {
          method: "DELETE",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            userId: user.id,
            confirmUsername: typedUsername
          })
        }
      );

      showStatus(result.message || "Account removed successfully.");

      await refreshPermissions();

    } catch (error) {
      showStatus(error.message, true);

    } finally {
      button.disabled = false;
      button.textContent = "Delete account";
    }
  }

  $("#create-form").addEventListener("submit", async event => {
    event.preventDefault();

    const button = $("#create-button");
    const message = $("#create-message");

    button.disabled = true;
    button.textContent = "Creating account...";
    message.textContent = "";

    const username = $("#new-username").value.trim();
    const password = $("#new-password").value;
    const role = $("#new-role").value;

    try {
      await requestJson("/api/admin/accounts", {
        method: "POST",
        headers: {
          "Content-Type": "application/json"
        },
        body: JSON.stringify({
          username,
          password,
          role
        })
      });

      message.textContent = "Account created successfully.";
      message.className = "form-message success";

      $("#create-form").reset();

      await refreshPermissions();

    } catch (error) {
      message.textContent = error.message;
      message.className = "form-message error";

    } finally {
      button.disabled = false;
      button.textContent = "Create account";
    }
  });

  $("#refresh-button").addEventListener("click", async () => {
    const button = $("#refresh-button");
    button.disabled = true;

    try {
      await refreshPermissions();
      showStatus("Account list refreshed.");

    } catch (error) {
      showStatus(error.message, true);

    } finally {
      button.disabled = false;
    }
  });

  loadPage();
</script>

<style>
  .accounts-page {
    padding-block: 2.5rem 4rem;
  }

  .page-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .page-heading h1 {
    margin: 0.5rem 0;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .intro,
  .panel-heading p:not(.eyebrow) {
    color: var(--muted);
    line-height: 1.6;
  }

  .back-button,
  .secondary-button,
  .primary-button,
  .danger-button {
    display: inline-block;
    border: 1px solid var(--accent);
    padding: 0.7rem 1rem;
    background: transparent;
    color: var(--accent);
    font: inherit;
    font-size: 0.88rem;
    text-decoration: none;
    cursor: pointer;
  }

  .primary-button {
    background: var(--accent);
    color: white;
  }

  .back-button:hover,
  .secondary-button:hover {
    background: var(--accent-soft);
  }

  .danger-button {
    border-color: #b42318;
    background: #b42318;
    color: #fff;
  }

  .danger-button:hover:not(:disabled) {
    background: #8f1c13;
  }

  button:disabled {
    opacity: 0.55;
    cursor: wait;
  }

  .status {
    padding: 1rem;
    border: 1px solid var(--rule);
    color: var(--muted);
  }

  .status[hidden] {
    display: none !important;
  }

  .status.error,
  .form-message.error {
    color: #b42318;
  }

  .panel {
    margin-top: 1.5rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    background: var(--surface);
  }

  .panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .panel-heading h2 {
    margin: 0.4rem 0;
  }

  .panel-heading p {
    margin-bottom: 0;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }

  .form-grid label {
    display: grid;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .form-grid input,
  .form-grid select {
    width: 100%;
    min-height: 44px;
    padding: 0.7rem;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
  }

  .form-grid small {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 400;
    line-height: 1.5;
  }

  .form-message {
    min-height: 1.3rem;
    font-size: 0.88rem;
  }

  .form-message.success {
    color: #18794e;
  }

  .account-list,
  #account-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    align-items: stretch;
  }

  .account-card {
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-width: 0;
    padding: 1.25rem;
    border: 1px solid #555;
    border-radius: 4px;
    background: #171717;
  }

  .editor-profile {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .editor-avatar {
    width: 76px;
    height: 76px;
    min-width: 76px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--accent-soft);
    border: 1px solid var(--rule);
  }

  .account-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #444;
  }

  .account-identity {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
    min-width: 0;
  }

  .account-identity h3 {
    margin: 0;
    overflow-wrap: anywhere;
    font-size: 1.1rem;
  }

  .editor-username {
    color: #aaa;
    font-size: 0.82rem;
  }

  .role-label,
  .account-status {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--rule);
