
---
import Editorial from "../../../../layouts/Editorial.astro";

const description = "Create and publish a topic for DraftLaw Research.";
---

<Editorial title="Create topic" description={description}>
  <div class="wrap topic-wrap">
    <header class="page-title">
      <p class="eyebrow">EDITORIAL WORKSPACE / TOPICS</p>
      <h1>Create a topic</h1>
      <p>Add a topic to the website. Topics are published directly without an approval step.</p>
    </header>

    <p id="access-status" class="notice" role="status">Checking your account...</p>

    <form id="topic-form" hidden>
      <section class="form-section">
        <h2>Topic information</h2>

        <div class="field">
          <label for="name">Topic name <span>*</span></label>
          <input
            id="name"
            name="name"
            type="text"
            maxlength="160"
            placeholder="e.g. Human Rights"
            required
          />
          <p class="help">Use the name readers should see on the website.</p>
        </div>

        <div class="field">
          <label for="description">One-line description <span>*</span></label>
          <textarea
            id="description"
            name="description"
            rows="3"
            placeholder="Briefly describe what this topic covers."
            required
          ></textarea>
          <p class="help">Keep this short; it will be used to introduce the topic.</p>
        </div>

        <div class="field">
          <label for="order">Display order</label>
          <input
            id="order"
            name="order"
            type="number"
            step="any"
            placeholder="e.g. 1"
          />
          <p class="help">Optional. Smaller numbers appear first. Leave blank if you do not need a specific order.</p>
        </div>
      </section>

      <div class="form-actions">
        <a class="back-link" href="/editorial/dashboard/">← Back to workspace</a>
        <button id="publish-button" type="submit">Save and publish</button>
      </div>
      <p id="form-message" class="notice" role="status" aria-live="polite"></p>
    </form>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>("#topic-form")!;
    const accessStatus = document.querySelector<HTMLElement>("#access-status")!;
    const publishButton = document.querySelector<HTMLButtonElement>("#publish-button")!;
    const message = document.querySelector<HTMLElement>("#form-message")!;

    
async function checkSession() {
  try {
    const response = await fetch("/api/auth/me", {
      credentials: "same-origin",
      cache: "no-store"
    });

    const result = await response.json();

    if (
      !response.ok ||
      !result.ok ||
      !["admin", "editor"].includes(result.user?.role)
    ) {
      window.location.replace("/editorial/");
      return;
    }

    // Admins can access every section.
    if (result.user.role === "admin") {
      accessStatus.hidden = true;
      form.hidden = false;
      return;
    }

    // Verify the Editor's section permissions.
    const permissionResponse = await fetch(
      "/api/auth/section-permissions",
      {
        credentials: "same-origin",
        cache: "no-store"
      }
    );

    const permissionResult = await permissionResponse.json();

    if (
      !permissionResponse.ok ||
      !permissionResult.ok ||
      !Array.isArray(permissionResult.permissions)
    ) {
      throw new Error("Could not verify section permissions.");
    }

    // Editors must have Topics permission.
    if (!permissionResult.permissions.includes("topics")) {
      window.location.replace("/editorial/dashboard/");
      return;
    }

    accessStatus.hidden = true;
    form.hidden = false;

  } catch {
    accessStatus.textContent =
      "Unable to verify your account permissions. Please refresh the page.";
  }
}

    form.addEventListener("submit", async event => {
      event.preventDefault();
      message.textContent = "";
      message.classList.remove("success");
      publishButton.disabled = true;
      publishButton.textContent = "Publishing...";

      try {
        const data = new FormData(form);
        const payload = {
          name: String(data.get("name") || "").trim(),
          description: String(data.get("description") || "").trim(),
          order: String(data.get("order") || "").trim()
        };

        const response = await fetch("/api/topics/create", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          throw new Error(result.message || "The topic could not be published.");
        }

        message.textContent = `${result.message} File: ${result.path}`;
        message.classList.add("success");
        form.reset();
        window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
      } catch (error) {
        message.textContent = error instanceof Error
          ? error.message
          : "Something went wrong. Please try again.";
      } finally {
        publishButton.disabled = false;
        publishButton.textContent = "Save and publish";
      }
    });

    checkSession();
  </script>

  <style>
    .topic-wrap { max-width: 900px; padding-bottom: 4rem; }
    .page-title { padding: 2.5rem 0 1.5rem; }
    .page-title h1 { margin: .4rem 0; }
    .page-title > p:last-child, .help { color: var(--muted, #aaa); line-height: 1.6; }

    .form-section {
      padding: 1.8rem;
      margin: 1rem 0;
      border: 1px solid rgba(255,255,255,.12);
      border-radius: 16px;
      background: rgba(3,3,3,.88);
      box-shadow: 0 25px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.05);
      -webkit-backdrop-filter: blur(22px);
      backdrop-filter: blur(22px);
    }

    .form-section h2 { margin: 0 0 1.2rem; font-size: 1.25rem; }
    .field { margin: 1.2rem 0; }
    .field label { display: block; margin-bottom: .45rem; font-weight: 600; }
    .field label span { color: #c9a978; }

    .field input, .field textarea {
      width: 100%;
      padding: .85rem .9rem;
      border: 1px solid rgba(255,255,255,.17);
      border-radius: 8px;
      background: rgba(255,255,255,.055);
      color: var(--text, #f5f0e8);
      font: inherit;
    }

    .field input:focus, .field textarea:focus {
      outline: 2px solid rgba(182,157,115,.55);
      outline-offset: 1px;
    }

    .field textarea { resize: vertical; }
    .help { margin: .5rem 0; font-size: .9rem; }

    .form-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem 0;
    }

    .back-link { color: inherit; }

    button[type="submit"] {
      border: 1px solid #c5a977;
      border-radius: 8px;
      padding: .9rem 1.3rem;
      background: #b69d73;
      color: #10100e;
      font: inherit;
      font-weight: 700;
      cursor: pointer;
    }

    button[type="submit"]:hover:not(:disabled) { background: #cbb48c; }
    button:disabled { opacity: .6; cursor: wait; }

    .notice {
      padding: .9rem 1rem;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 8px;
      background: rgba(3,3,3,.75);
      color: var(--text, #eee);
      line-height: 1.5;
    }

    .notice.success { border-color: #32845a; }

    @media (max-width: 600px) {
      .form-actions { align-items: stretch; flex-direction: column; }
      button[type="submit"] { width: 100%; }
    }
  </style>
</Editorial>
