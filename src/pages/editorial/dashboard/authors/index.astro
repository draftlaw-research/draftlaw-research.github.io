
---
import Editorial from "../../../../layouts/Editorial.astro";

const description = "Create and publish an author profile for DraftLaw Research.";
---

<Editorial title="Create author profile" description={description}>
  <div class="wrap author-wrap">
    <header class="page-title">
      <p class="eyebrow">EDITORIAL WORKSPACE / AUTHORS</p>
      <h1>Create an author profile</h1>
      <p>Add a contributor to the website. Author profiles are published directly without an approval step.</p>
    </header>

    <p id="access-status" class="notice" role="status">Checking your account...</p>

    <form id="author-form" hidden>
      <section class="form-section">
        <h2>Basic information</h2>

        <div class="field">
          <label for="name">Full name <span>*</span></label>
          <input id="name" name="name" type="text" maxlength="160" required />
        </div>

        <div class="field">
          <label for="role">Role or occupation</label>
          <input id="role" name="role" type="text" maxlength="180" placeholder="e.g. Legal researcher, lecturer, student" />
        </div>

        <div class="field">
          <label for="affiliation">University or organisation</label>
          <input id="affiliation" name="affiliation" type="text" maxlength="180" />
        </div>

        <div class="field">
          <label for="country">Country</label>
          <input id="country" name="country" type="text" maxlength="100" />
        </div>
      </section>

      <section class="form-section">
        <h2>Profile photo</h2>
        <p class="help">
          A square image works best. JPEG, PNG and WebP are accepted.
          Images larger than 200 KB will be compressed automatically before upload.
        </p>

        <div class="field">
          <label for="photo">Photo</label>
          <input id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp" />
          <p id="photo-status" class="help" aria-live="polite"></p>
          <img id="photo-preview" alt="Selected author photo preview" hidden />
        </div>
      </section>

      <section class="form-section">
        <h2>Professional links</h2>

        <div class="field">
          <label for="orcid">ORCID (optional)</label>
          <input id="orcid" name="orcid" type="text" placeholder="0000-0000-0000-0000" />
        </div>

        <div class="field">
          <label for="linkedin">LinkedIn link (optional)</label>
          <input id="linkedin" name="linkedin" type="url" placeholder="https://..." />
        </div>

        <div class="field">
          <label for="facebook">Facebook link (optional)</label>
          <input id="facebook" name="facebook" type="url" placeholder="https://..." />
        </div>

        <div class="field">
          <label for="instagram">Instagram link (optional)</label>
          <input id="instagram" name="instagram" type="url" placeholder="https://..." />
        </div>

        <div class="field">
          <label for="website">Website link (optional)</label>
          <input id="website" name="website" type="url" placeholder="https://..." />
        </div>
      </section>

      <section class="form-section">
        <h2>Short biography</h2>

        <div class="field">
          <label for="body">Bio</label>
          <textarea
            id="body"
            name="body"
            rows="7"
            placeholder="Write a short biography. Basic Markdown formatting is supported."
          ></textarea>
          <p class="help">
            This field is optional. You can use basic Markdown, such as **bold** and *italic*.
          </p>
        </div>
      </section>

      <div class="form-actions">
        <a class="back-link" href="/editorial/dashboard/">← Back to workspace</a>
        <button id="publish-button" type="submit">Save and publish</button>
      </div>

      <p id="form-message" class="notice" role="status" aria-live="polite"></p>
    </form>
  </div>

  <script>
    const form = document.querySelector<HTMLFormElement>("#author-form")!;
    const accessStatus = document.querySelector<HTMLElement>("#access-status")!;
    const photoInput = document.querySelector<HTMLInputElement>("#photo")!;
    const photoStatus = document.querySelector<HTMLElement>("#photo-status")!;
    const preview = document.querySelector<HTMLImageElement>("#photo-preview")!;
    const publishButton = document.querySelector<HTMLButtonElement>("#publish-button")!;
    const message = document.querySelector<HTMLElement>("#form-message")!;

    const MAX_IMAGE_SIZE = 200 * 1024;
    const UPLOAD_TIMEOUT = 45000;
    const API_TIMEOUT = 20000;

    let uploadedPhoto = "";
    let previewUrl = "";
    let compressionPromise: Promise<File> | null = null;
    let compressionFile: File | null = null;
    let selectionVersion = 0;

    function fileSize(bytes: number): string {
      return `${(bytes / 1024).toFixed(1)} KB`;
    }

    async function readJson(response: Response): Promise<any> {
      const text = await response.text();

      if (!text.trim()) {
        throw new Error(
          `The server returned an empty response (HTTP ${response.status}).`
        );
      }

      try {
        return JSON.parse(text);
      } catch {
        throw new Error(
          `The server returned an invalid response (HTTP ${response.status}). Please check the server logs.`
        );
      }
    }

    async function fetchWithTimeout(
      url: string,
      options: RequestInit,
      timeout: number
    ): Promise<Response> {
      const controller = new AbortController();
      const timeoutId = window.setTimeout(
        () => controller.abort(),
        timeout
      );

      try {
        return await fetch(url, {
          ...options,
          signal: controller.signal
        });
      } catch (error) {
        if (error instanceof Error && error.name === "AbortError") {
          throw new Error(
            "The request took too long. Please check your connection and try again."
          );
        }

        throw error;
      } finally {
        window.clearTimeout(timeoutId);
      }
    }

    async function checkSession(): Promise<void> {
      try {
        const response = await fetchWithTimeout(
          "/api/auth/me",
          {
            credentials: "same-origin",
            cache: "no-store"
          },
          API_TIMEOUT
        );

        const result = await readJson(response);

        if (
          !response.ok ||
          !result.ok ||
          !["admin", "editor"].includes(result.user?.role)
        ) {
          window.location.replace("/editorial/");
          return;
        }

        if (result.user.role === "admin") {
          accessStatus.hidden = true;
          form.hidden = false;
          return;
        }

        const permissionResponse = await fetchWithTimeout(
          "/api/auth/section-permissions",
          {
            credentials: "same-origin",
            cache: "no-store"
          },
          API_TIMEOUT
        );

        const permissionResult = await readJson(permissionResponse);

        if (
          !permissionResponse.ok ||
          !permissionResult.ok ||
          !Array.isArray(permissionResult.permissions)
        ) {
          throw new Error("Could not verify your section permissions.");
        }

        if (!permissionResult.permissions.includes("authors")) {
          window.location.replace("/editorial/dashboard/");
          return;
        }

        accessStatus.hidden = true;
        form.hidden = false;

      } catch (error) {
        accessStatus.textContent =
          error instanceof Error
            ? error.message
            : "Unable to verify your account permissions. Please refresh the page.";
      }
    }

    async function canvasToBlob(
      canvas: HTMLCanvasElement,
      quality: number
    ): Promise<Blob> {
      return new Promise((resolve, reject) => {
        canvas.toBlob(
          (blob) => {
            if (!blob) {
              reject(new Error("The browser could not process this image."));
              return;
            }

            resolve(blob);
          },
          "image/webp",
          quality
        );
      });
    }

    async function compressPhoto(file: File): Promise<File> {
      if (!file.type.startsWith("image/")) {
        throw new Error("Please select a valid image file.");
      }

      if (
        !["image/jpeg", "image/png", "image/webp"].includes(file.type)
      ) {
        throw new Error("Only JPEG, PNG and WebP images are supported.");
      }

      if (file.size <= MAX_IMAGE_SIZE) {
        return file;
      }

      if (!("createImageBitmap" in window)) {
        throw new Error(
          "Your browser cannot compress this image. Please use a newer browser."
        );
      }

      photoStatus.textContent = "Preparing image for compression...";

      const image = await createImageBitmap(file);

      try {
        const canvas = document.createElement("canvas");
        const context = canvas.getContext("2d");

        if (!context) {
          throw new Error("Image compression could not be started.");
        }

        let width = image.width;
        let height = image.height;

        const MAX_DIMENSION = 1600;

        if (Math.max(width, height) > MAX_DIMENSION) {
          const scale = MAX_DIMENSION / Math.max(width, height);
          width = Math.round(width * scale);
          height = Math.round(height * scale);
        }

        const base = file.name.replace(/\.[^.]+$/, "") || "author-photo";

        const qualities = [
          0.90, 0.85, 0.80, 0.75, 0.70,
          0.65, 0.60, 0.55, 0.50, 0.45, 0.40, 0.35
        ];

        for (let resizeAttempt = 0; resizeAttempt < 9; resizeAttempt++) {
          canvas.width = width;
          canvas.height = height;

          context.clearRect(0, 0, width, height);
          context.drawImage(image, 0, 0, width, height);

          for (const quality of qualities) {
            const blob = await canvasToBlob(canvas, quality);

            if (blob.size <= MAX_IMAGE_SIZE) {
              return new File(
                [blob],
                `${base}.webp`,
                {
                  type: "image/webp",
                  lastModified: Date.now()
                }
              );
            }
          }

          width = Math.max(1, Math.round(width * 0.8));
          height = Math.max(1, Math.round(height * 0.8));
        }

        throw new Error(
          "This photo could not be reduced to 200 KB. Please choose a smaller image."
        );

      } finally {
        image.close();
      }
    }

    function preparePhoto(file: File, version: number): Promise<File> {
      compressionFile = file;

      if (file.size <= MAX_IMAGE_SIZE) {
        compressionPromise = Promise.resolve(file);
        photoStatus.textContent = `Image size: ${fileSize(file.size)}. Ready to upload.`;
        return compressionPromise;
      }

      photoStatus.textContent = `Compressing ${fileSize(file.size)}...`;

      compressionPromise = compressPhoto(file)
        .then((compressed) => {
          if (version !== selectionVersion) {
            return compressed;
          }

          photoStatus.textContent =
            `Compressed from ${fileSize(file.size)} to ${fileSize(compressed.size)}. Ready to upload.`;

          return compressed;
        })
        .catch((error) => {
          if (version === selectionVersion) {
            photoStatus.textContent =
              error instanceof Error
                ? error.message
                : "Image compression failed.";
          }

          throw error;
        });

      return compressionPromise;
    }

    async function uploadPhoto(
      originalFile: File,
      version: number
    ): Promise<string> {
      if (
        !compressionPromise ||
        compressionFile !== originalFile
      ) {
        preparePhoto(originalFile, version);
      }

      if (!compressionPromise) {
        throw new Error("The image could not be prepared.");
      }

      const compressed = await compressionPromise;

      if (version !== selectionVersion) {
        throw new Error("The selected photo changed. Please submit again.");
      }

      if (compressed.size > MAX_IMAGE_SIZE) {
        throw new Error("The compressed image exceeds the 200 KB limit.");
      }

      photoStatus.textContent =
        fileSize(originalFile.size) > fileSize(compressed.size)
          ? `Compressed from ${fileSize(originalFile.size)} to ${fileSize(compressed.size)}. Uploading...`
          : `Image size: ${fileSize(compressed.size)}. Uploading...`;

      const data = new FormData();
      data.append("photo", compressed);

      const response = await fetchWithTimeout(
        "/api/uploads/author-photo",
        {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          body: data
        },
        UPLOAD_TIMEOUT
      );

      const result = await readJson(response);

      if (!response.ok || !result.ok || !result.photo) {
        throw new Error(
          result.message || "The photo could not be uploaded."
        );
      }

      if (version !== selectionVersion) {
        throw new Error("The selected photo changed during upload. Please submit again.");
      }

      photoStatus.textContent =
        `Photo uploaded successfully (${fileSize(compressed.size)}).`;

      return result.photo;
    }

    photoInput.addEventListener("change", () => {
      selectionVersion++;

      const version = selectionVersion;
      uploadedPhoto = "";
      compressionPromise = null;
      compressionFile = null;

      const file = photoInput.files?.[0];

      if (previewUrl) {
        URL.revokeObjectURL(previewUrl);
        previewUrl = "";
      }

      if (!file) {
        preview.hidden = true;
        preview.removeAttribute("src");
        photoStatus.textContent = "";
        return;
      }

      if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
        photoInput.value = "";
        preview.hidden = true;
        photoStatus.textContent = "Please select a JPEG, PNG or WebP image.";
        return;
      }

      previewUrl = URL.createObjectURL(file);
      preview.src = previewUrl;
      preview.hidden = false;

      if (file.size > MAX_IMAGE_SIZE) {
        preparePhoto(file, version).catch(() => {
          // The error is already displayed in the photo status.
        });
      } else {
        preparePhoto(file, version);
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) {
        return;
      }

      if (publishButton.disabled) {
        return;
      }

      message.textContent = "";
      message.classList.remove("success");

      publishButton.disabled = true;
      publishButton.textContent = "Publishing...";

      const submissionVersion = selectionVersion;

      try {
        const data = new FormData(form);
        const photo = photoInput.files?.[0];

        uploadedPhoto = "";

        if (photo) {
          message.textContent = "Preparing and uploading profile photo...";

          uploadedPhoto = await uploadPhoto(
            photo,
            submissionVersion
          );
        }

        if (submissionVersion !== selectionVersion) {
          throw new Error(
            "The selected photo changed during submission. Please submit again."
          );
        }

        const payload: Record<string, string> = {};

        const fields = [
          "name",
          "role",
          "affiliation",
          "country",
          "orcid",
          "linkedin",
          "facebook",
          "instagram",
          "website",
          "body"
        ];

        for (const key of fields) {
          payload[key] = String(data.get(key) || "").trim();
        }

        payload.photo = uploadedPhoto;

        message.textContent = "Publishing author profile...";

        const response = await fetchWithTimeout(
          "/api/authors/create",
          {
            method: "POST",
            credentials: "same-origin",
            cache: "no-store",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
          },
          API_TIMEOUT
        );

        const result = await readJson(response);

        if (!response.ok || !result.ok) {
          throw new Error(
            result.message || "The author profile could not be published."
          );
        }

        message.textContent =
          `${result.message} Profile: ${result.path}`;

        message.classList.add("success");

        form.reset();

        uploadedPhoto = "";
        compressionPromise = null;
        compressionFile = null;
        selectionVersion++;

        preview.hidden = true;
        preview.removeAttribute("src");
        photoStatus.textContent = "";

        if (previewUrl) {
          URL.revokeObjectURL(previewUrl);
          previewUrl = "";
        }

        window.scrollTo({
          top: document.body.scrollHeight,
          behavior: "smooth"
        });

      } catch (error) {
        message.textContent =
          error instanceof Error
            ? error.message
            : "Something went wrong. Please try again.";

        message.classList.remove("success");

      } finally {
        publishButton.disabled = false;
        publishButton.textContent = "Save and publish";
      }
    });

    checkSession();
  </script>

  <style>
    .author-wrap {
      max-width: 900px;
      padding-bottom: 6rem;
    }

    .page-title {
      padding: 2.5rem 0 1.5rem;
    }

    .page-title h1 {
      margin: .4rem 0;
    }

    .page-title > p:last-child,
    .help {
      color: var(--muted, #666);
      line-height: 1.6;
    }

    .form-section {
      border-top: 1px solid var(--rule);
      padding: 1.8rem 0;
    }

    .form-section h2 {
      font-size: 1.25rem;
      margin: 0 0 1.2rem;
    }

    .field {
      margin: 1rem 0;
    }

    .field label {
      display: block;
      margin-bottom: .45rem;
      font-weight: 600;
    }

    .field label span {
      color: #b42318;
    }

    .field input:not([type="file"]),
    .field textarea {
      width: 100%;
      padding: .8rem .9rem;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--surface);
      color: var(--text);
      font: inherit;
    }

    .field textarea {
      resize: vertical;
    }

    .help {
      font-size: .9rem;
      margin: .5rem 0;
    }

    #photo-preview {
      display: block;
      width: 150px;
      height: 150px;
      object-fit: cover;
      border-radius: 50%;
      margin-top: 1rem;
      border: 1px solid var(--rule);
    }

    .form-actions {
      position: sticky;
      bottom: 0;
      z-index: 100;
      display: flex !important;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      padding: 1rem;
      margin: 1.5rem -1rem 0;
      background: var(--surface);
      border: 1px solid var(--rule);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, .18);
    }

    .back-link {
      color: inherit;
      text-decoration: none;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    #publish-button {
      display: inline-flex !important;
      visibility: visible !important;
      opacity: 1 !important;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      border: 0;
      padding: .9rem 1.5rem;
      background: var(--accent);
      color: var(--accent-ink);
      font: inherit;
      font-weight: 700;
      cursor: pointer;
      border-radius: 4px;
    }

    #publish-button:hover:not(:disabled) {
      filter: brightness(.92);
    }

    #publish-button:disabled {
      opacity: .6 !important;
      cursor: wait;
    }

    .notice {
      padding: .9rem 1rem;
      background: var(--surface);
      border: 1px solid var(--rule);
      line-height: 1.5;
    }

    .notice.success {
      border-color: #32845a;
    }

    @media (max-width: 600px) {
      .form-actions {
        align-items: stretch;
        flex-direction: column;
        margin-inline: 0;
      }

      #publish-button {
        width: 100%;
      }
    }
  </style>
</Editorial>
