
---
import Base from '../../../layouts/Base.astro';

const description = 'The DraftLaw Research editorial workspace.';
---

<Base title="Editorial Dashboard" description={description} indexed={false}>
  <div class="wrap">

    <div class="dashboard-topline">
      <div class="editorial-brand">
        <img src="/logo.svg" alt="DraftLaw Research logo" />
        <p class="eyebrow">DRAFTLAW RESEARCH / EDITORIAL</p>
      </div>

      <div id="account-info" class="account-info" hidden>
        <div class="account-details">
          <span class="account-label">SIGNED IN AS</span>
          <strong id="user-name"></strong>
          <span class="account-role" id="user-role"></span>
        </div>
        <a href="/" class="public-link">Visit public website ↗</a>
      </div>
    </div>

    <header class="page-title dashboard-heading">
      <h1>Editorial Dashboard</h1>
      <p>Manage editorial work and website content from one place.</p>
    </header>

    <div id="workspace" hidden>

      <section class="section">
        <div class="section-head">
          <h2>Your workspace</h2>
        </div>

        <div class="dashboard-grid">
          <article class="dashboard-card">
            <p class="eyebrow">01 / CONTENT</p>
            <h3>Website content</h3>
            <p>Create and manage articles, guides, authors, topics and other website content.</p>
            <span class="coming-soon">Management tools coming soon</span>
          </article>

          <article class="dashboard-card">
            <p class="eyebrow">02 / REVIEW</p>
            <h3>Submissions and approvals</h3>
            <p>Review proposed content and changes before they appear on the public website.</p>
            <span class="coming-soon">Review tools coming soon</span>
          </article>

          <article class="dashboard-card admin-only" hidden>
            <p class="eyebrow">03 / TEAM</p>
            <h3>Editor accounts</h3>
            <p>Create editor accounts and manage their access to the portal.</p>
            <span class="coming-soon">Account management coming soon</span>
          </article>

          <article class="dashboard-card admin-only" hidden>
            <p class="eyebrow">04 / RECORDS</p>
            <h3>Activity log</h3>
            <p>Review the actions performed by administrators and editors.</p>
            <span class="coming-soon">Activity records coming soon</span>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <h2>Editorial process</h2>
        </div>
        <p class="process-note">
          Changes proposed by editors will require administrative approval
          before they can be published on the public website.
        </p>
      </section>

    </div>

    <p id="status-message" role="status" class="status-message">
      Verifying your session...
    </p>
  </div>

  <script>
    async function loadDashboard() {
      const status = document.querySelector('#status-message');
      const workspace = document.querySelector('#workspace');
      const accountInfo = document.querySelector('#account-info');

      try {
        const response = await fetch('/api/auth/me', {
          credentials: 'same-origin',
          cache: 'no-store'
        });

        if (!response.ok) {
          window.location.replace('/editorial');
          return;
        }

        const result = await response.json();

        if (!result.ok || !result.user ||
            !['admin', 'editor'].includes(result.user.role)) {
          window.location.replace('/editorial');
          return;
        }

        document.querySelector('#user-name').textContent =
          result.user.username;

        document.querySelector('#user-role').textContent =
          result.user.role === 'admin' ? 'Administrator' : 'Editor';

        if (result.user.role === 'admin') {
          document.querySelectorAll('.admin-only').forEach((item) => {
            item.hidden = false;
          });
        }

        accountInfo.hidden = false;
        workspace.hidden = false;
        status.hidden = true;

      } catch {
        status.textContent =
          'We could not verify your session. Please refresh or log in again.';
      }
    }

    loadDashboard();
  </script>

  <style>
    .dashboard-topline {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1.5rem;
      padding-top: 1.2rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--rule);
    }

    .editorial-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      min-width: 0;
    }

    .editorial-brand img {
      width: 38px;
      height: 38px;
      object-fit: contain;
    }

    .editorial-brand .eyebrow {
      margin: 0;
    }

    .account-info {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 0.75rem;
      text-align: right;
      font-family: var(--font-ui);
    }

    .account-details {
      display: flex;
      align-items: baseline;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 0.4rem;
      font-size: 0.72rem;
    }

    .account-label {
      color: var(--muted);
      font-size: 0.61rem;
      letter-spacing: 0.1em;
    }

    .account-details strong {
      color: var(--ink);
      font-size: 0.75rem;
      font-weight: 600;
    }

    .account-role {
      color: var(--accent);
      font-size: 0.7rem;
    }

    .public-link {
      color: var(--muted);
      font-size: 0.7rem;
      text-decoration: none;
      white-space: nowrap;
    }

    .public-link:hover {
      color: var(--accent);
    }

    .dashboard-heading {
      padding-top: 2rem;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
    }

    .dashboard-card {
      padding: 1.7rem;
      background: var(--surface);
      min-width: 0;
    }

    .dashboard-card h3 {
      margin: 0.8rem 0 0.6rem;
      font-size: 1.4rem;
    }

    .dashboard-card > p:not(.eyebrow) {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.6;
      max-width: 48ch;
    }

    .coming-soon {
      display: inline-block;
      margin-top: 0.6rem;
      padding-top: 0.7rem;
      border-top: 1px solid var(--rule);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--accent);
    }

    .process-note {
      max-width: 70ch;
      color: var(--muted);
    }

    .status-message {
      padding-block: 2rem;
      color: var(--muted);
    }

    @media (max-width: 700px) {
      .dashboard-topline {
        flex-direction: column;
        align-items: flex-start;
      }

      .account-info {
        justify-content: flex-start;
        text-align: left;
      }

      .account-details {
        justify-content: flex-start;
      }
    }

    @media (max-width: 650px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Base>
