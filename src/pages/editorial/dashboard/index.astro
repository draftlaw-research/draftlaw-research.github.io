---
import Editorial from "../../../layouts/Editorial.astro";

const description = "The DraftLaw Research editorial workspace.";
---

<Editorial title="Editorial Dashboard" description={description}>
  <div class="wrap">
    <header class="page-title dashboard-heading">
      <p class="eyebrow">EDITORIAL WORKSPACE</p>
      <h1>Editorial Dashboard</h1>
      <p>Manage editorial work from one place.</p>
    </header>

    <div id="workspace" hidden>
      <section class="section">
        <div class="section-head">
          <h2>Your workspace</h2>
        </div>

        <div class="dashboard-grid">
          <a
            class="dashboard-card submission-card"
            id="submissions"
            href="/editorial/submissions/new/"
          >
            <p class="eyebrow">01 / REVIEW</p>
            <h3>Submissions and approvals</h3>
            <p>Review proposed content and changes before they appear on the public website.</p>
            <span class="action-button submission-action">
              Open submission workspace →
            </span>
          </a>

          <article class="dashboard-card admin-only" id="accounts" hidden>
            <p class="eyebrow">02 / TEAM</p>
            <h3>Editor accounts</h3>
            <p>Create editor accounts and manage their access to the portal.</p>
            <a class="action-button" href="/editorial/admin/accounts/">
              Open editor accounts →
            </a>
          </article>

          <article class="dashboard-card admin-only" id="activity" hidden>
            <p class="eyebrow">03 / RECORDS</p>
            <h3>Activity log</h3>
            <p>Review the actions performed by administrators and editors.</p>
            <span class="coming-soon">Activity records coming soon</span>
          </article>
        </div>
      </section>

      <section class="section" id="process">
        <div class="section-head">
          <h2>Editorial process</h2>
        </div>
        <p class="process-note">
          Changes proposed by editors will require administrative approval
          before they can be published on the public website.
        </p>
      </section>
    </div>

    <p id="status-message" role="status" class="status-message">
      Verifying your session...
    </p>
  </div>

  <script>
    const $ = (selector) => document.querySelector(selector);

    async function loadDashboard() {
      const status = $("#status-message");
      const workspace = $("#workspace");

      try {
        const response = await fetch("/api/auth/me", {
          credentials: "same-origin",
          cache: "no-store"
        });

        if (!response.ok) {
          window.location.replace("/editorial");
          return;
        }

        const result = await response.json();

        if (
          !result.ok ||
          !result.user ||
          !["admin", "editor"].includes(result.user.role)
        ) {
          window.location.replace("/editorial");
          return;
        }

        const currentRole = result.user.role;

        $("#editorial-user-name").textContent =
          currentRole === "admin" ? "Admin" : result.user.username;

        if (currentRole === "admin") {
          $("#admin-shortcuts").hidden = false;

          document.querySelectorAll(".admin-only").forEach((item) => {
            item.hidden = false;
          });
        } else {
          $("#editor-shortcuts").hidden = false;
        }

        $("#editorial-account").hidden = false;
        workspace.hidden = false;
        status.hidden = true;
      } catch {
        status.textContent =
          "We could not verify your session. Please refresh or log in again.";
      }
    }

    loadDashboard();
  </script>

  <style>
    .dashboard-heading {
      padding-top: 2rem;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1px;
      background: var(--rule);
      border: 1px solid var(--rule);
    }

    .dashboard-card {
      padding: 1.7rem;
      background: var(--surface);
      min-width: 0;
    }

    .dashboard-card h3 {
      margin: 0.8rem 0 0.6rem;
      font-size: 1.4rem;
    }

    .dashboard-card > p:not(.eyebrow) {
      color: var(--muted);
      font-size: 0.98rem;
      line-height: 1.6;
      max-width: 48ch;
    }

    .submission-card {
      display: block;
      color: inherit;
      text-decoration: none;
      transition: background 0.2s ease;
    }

    .submission-card:hover {
      background: var(--accent-soft);
    }

    .submission-card:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -3px;
    }

    .submission-action {
      display: inline-block;
    }

    .coming-soon {
      display: inline-block;
      margin-top: 0.6rem;
      padding-top: 0.7rem;
      border-top: 1px solid var(--rule);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--accent);
    }

    .action-button {
      display: inline-block;
      margin-top: 0.8rem;
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      padding: 0.7rem 1rem;
      font: inherit;
      font-size: 0.88rem;
      text-decoration: none;
    }

    .action-button:hover {
      background: var(--accent-soft);
    }

    .process-note {
      max-width: 70ch;
      color: var(--muted);
    }

    .status-message {
      padding-block: 2rem;
      color: var(--muted);
    }

    @media (max-width: 650px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Editorial>
