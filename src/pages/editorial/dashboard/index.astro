
---
import Editorial from "../../../layouts/Editorial.astro";

const description = "The DraftLaw Research editorial workspace.";
---

<Editorial title="Editorial Dashboard" description={description}>
  <div class="wrap">
    <header class="page-title dashboard-heading dashboard-title-row">
      <div>
        <p class="eyebrow">EDITORIAL WORKSPACE</p>
        <h1>Editorial Dashboard</h1>
        <p>Manage publications, contributors and website sections from one place.</p>
      </div>
    </header>

    <div id="workspace" hidden>
      <section class="section">
        <div class="section-head">
          <h2 id="workspace-heading">Editorial Workspace</h2>
        </div>

        <div class="dashboard-grid">

          <!-- PUBLICATIONS -->
          <article class="dashboard-card active-card" id="submissions" hidden>
            <p class="eyebrow">01 / PUBLICATIONS</p>
            <h3>Publications</h3>
            <p>
              Create, review and manage new publications, including articles
              and guidelines.
            </p>
            <a class="action-button" href="/editorial/submissions/">
              Manage publications →
            </a>
          </article>

          <!-- AUTHORS -->
          <article class="dashboard-card" id="authors" hidden>
            <p class="eyebrow">02 / CONTRIBUTORS</p>
            <h3>Authors</h3>
            <p>Create and publish author profiles for the website.</p>
            <a class="action-button" href="/editorial/dashboard/authors/">
              Create author profile →
            </a>
          </article>

          <!-- TOPICS -->
          <article class="dashboard-card" id="topics" hidden>
            <p class="eyebrow">03 / WEBSITE SECTION</p>
            <h3>Topics</h3>
            <p>
              Create and publish topics and categories used across the website.
            </p>
            <a class="action-button" href="/editorial/dashboard/topics/">
              Create topic →
            </a>
          </article>

          <!-- TEAM MEMBERS -->
          <article class="dashboard-card" id="team-members" hidden>
            <p class="eyebrow">04 / WEBSITE SECTION</p>
            <h3>Team Members</h3>
            <p>Add and publish members of the DraftLaw Research team.</p>
            <a class="action-button" href="/editorial/dashboard/team/">
              Add team member →
            </a>
          </article>

          <!-- STUDENT COLLABORATORS -->
          <article
            class="dashboard-card"
            id="student-collaborators"
            hidden
          >
            <p class="eyebrow">05 / WEBSITE SECTION</p>
            <h3>Student Collaborators</h3>
            <p>Add and publish Student Collaborator profiles.</p>
            <a
              class="action-button"
              href="/editorial/dashboard/student-collaborators/"
            >
              Add Student Collaborator →
            </a>
          </article>

          <!-- NEWSLETTER -->
          <article class="dashboard-card" id="newsletter-items" hidden>
            <p class="eyebrow">06 / WEBSITE SECTION</p>
            <h3>Newsletter Items</h3>
            <p>
              Publish calls for papers, events, competitions and opportunities.
            </p>
            <a class="action-button" href="/editorial/dashboard/newsletter/">
              Add newsletter item →
            </a>
          </article>

          <!-- PROGRAMS -->
          <article class="dashboard-card" id="programs" hidden>
            <p class="eyebrow">07 / INITIATIVES</p>
            <h3>Programs</h3>
            <p>Create and manage DraftLaw Research programs.</p>
            <a class="action-button" href="/editorial/dashboard/programs/">
              Add a program →
            </a>
          </article>

          <!-- PROGRAM ANNOUNCEMENTS -->
          <article class="dashboard-card" id="announcements" hidden>
            <p class="eyebrow">08 / INITIATIVES</p>
            <h3>Program Announcements</h3>
            <p>Publish open calls, program updates and results.</p>
            <a
              class="action-button"
              href="/editorial/dashboard/announcements/"
            >
              Add an announcement →
            </a>
          </article>

          <!-- ADMIN: EDITOR ACCOUNTS -->
          <article class="dashboard-card admin-only" id="accounts" hidden>
            <p class="eyebrow">09 / ADMINISTRATION</p>
            <h3>Editor Accounts</h3>
            <p>
              Create editor accounts and manage their access to the portal.
            </p>
            <a class="action-button" href="/editorial/admin/accounts/">
              Manage editor accounts →
            </a>
          </article>

          <!-- ADMIN: ACTIVITY LOG -->
          <article class="dashboard-card admin-only" id="activity" hidden>
            <p class="eyebrow">10 / ADMINISTRATION</p>
            <h3>Activity log</h3>
            <p>Review recent publication and development activity.</p>
            <a class="action-button" href="/editorial/dashboard/activity/">
              View activity log →
            </a>
          </article>

        </div>
      </section>

      <section class="section" id="process">
        <div class="section-head">
          <h2>Editorial process</h2>
        </div>

        <p class="process-note">
          Changes proposed by editors will require administrative approval
          before they can be published on the public website.
        </p>
      </section>
    </div>

    <p id="status-message" role="status" class="status-message">
      Verifying your session...
    </p>
  </div>

  <script>
    const $ = (selector: string) => document.querySelector(selector);

    // Connect each permission to its corresponding dashboard card.
    const sectionCards: Record<string, string[]> = {
      articles: ["submissions"],
      guides: ["submissions"],
      authors: ["authors"],
      topics: ["topics"],
      team: ["team-members"],
      "student-collaborators": ["student-collaborators"],
      newsletter: ["newsletter-items"],
      programs: ["programs"],
      announcements: ["announcements"]
    };

    async function loadDashboard() {
      const status = $("#status-message") as HTMLElement;
      const workspace = $("#workspace") as HTMLElement;

      try {
        // Verify the user's login session.
        const response = await fetch("/api/auth/me", {
          credentials: "same-origin",
          cache: "no-store"
        });

        if (!response.ok) {
          window.location.replace("/editorial");
          return;
        }

        const result = await response.json();

        if (
          !result.ok ||
          !result.user ||
          !["admin", "editor"].includes(result.user.role)
        ) {
          window.location.replace("/editorial");
          return;
        }

        const currentRole = result.user.role;

        // Update the name displayed in the editorial header.
        const userName = $("#editorial-user-name");

        if (userName) {
          userName.textContent =
            currentRole === "admin" ? "Admin" : result.user.username;
        }

        // Update the dashboard heading.
        const workspaceHeading = $("#workspace-heading");

        if (workspaceHeading) {
          workspaceHeading.textContent =
            currentRole === "admin"
              ? "Admin Workspace"
              : "Editor Workspace";
        }

        if (currentRole === "admin") {
          // Admins can see every content section.
          Object.values(sectionCards).flat().forEach((cardId) => {
            const card = document.getElementById(cardId);

            if (card) {
              card.hidden = false;
            }
          });

          // Show administrator-only cards.
          document.querySelectorAll(".admin-only").forEach((item) => {
            (item as HTMLElement).hidden = false;
          });

        } else {
          // Retrieve the Editor's assigned section permissions.
          const permissionResponse = await fetch(
            "/api/auth/section-permissions",
            {
              credentials: "same-origin",
              cache: "no-store"
            }
          );

          if (!permissionResponse.ok) {
            throw new Error("Could not verify section permissions.");
          }

          const permissionResult = await permissionResponse.json();

          if (
            !permissionResult.ok ||
            permissionResult.role !== "editor" ||
            !Array.isArray(permissionResult.permissions)
          ) {
            throw new Error("Invalid section permission response.");
          }

          const permissions = permissionResult.permissions;

          // Hide every content card before checking permissions.
          Object.values(sectionCards).flat().forEach((cardId) => {
            const card = document.getElementById(cardId);

            if (card) {
              card.hidden = true;
            }
          });

          // Show only cards assigned to this Editor.
          permissions.forEach((permission: string) => {
            const cardIds = sectionCards[permission] || [];

            cardIds.forEach((cardId) => {
              const card = document.getElementById(cardId);

              if (card) {
                card.hidden = false;
              }
            });
          });

          // Editors cannot see administrator-only cards.
          document.querySelectorAll(".admin-only").forEach((item) => {
            (item as HTMLElement).hidden = true;
          });
        }

        // Show account controls after verification.
        const editorialAccount = $("#editorial-account");

        if (editorialAccount) {
          (editorialAccount as HTMLElement).hidden = false;
        }

        // Reveal the dashboard only after permission checks succeed.
        workspace.hidden = false;
        status.hidden = true;

      } catch (error) {
        console.error("Dashboard loading failed:", error);

        workspace.hidden = true;
        status.hidden = false;
        status.textContent =
          "We could not verify your permissions. Please refresh or log in again.";
      }
    }

    loadDashboard();
  </script>

  <style>
    .dashboard-title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .dashboard-heading {
      padding-top: 2rem;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      background: transparent;
      border: 0;
    }

    .dashboard-card {
      position: relative;
      min-width: 0;
      padding: 1.7rem;
      border: 1px solid rgba(255, 255, 255, 0.13);
      border-radius: 16px;
      background: rgba(3, 3, 3, 0.88);
      box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.55),
        0 8px 22px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.06);
      -webkit-backdrop-filter: blur(22px);
      backdrop-filter: blur(22px);
      transition:
        transform 0.25s ease,
        border-color 0.25s ease,
        box-shadow 0.25s ease;
    }

    .dashboard-card:hover {
      transform: translateY(-4px);
      border-color: rgba(182, 157, 115, 0.55);
      box-shadow:
        0 32px 70px rgba(0, 0, 0, 0.65),
        0 12px 28px rgba(0, 0, 0, 0.35),
        inset 0 1px 0 rgba(255, 255, 255, 0.08);
    }

    .coming-soon {
      display: inline-block;
      margin-top: 0.6rem;
      padding-top: 0.7rem;
      border-top: 1px solid var(--rule);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--accent);
    }

    .action-button,
    .back-button {
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      padding: 0.7rem 1rem;
      cursor: pointer;
      font: inherit;
      font-size: 0.88rem;
    }

    .action-button {
      display: inline-block;
      margin-top: 0.8rem;
      text-decoration: none;
    }

    .action-button:hover,
    .back-button:hover {
      background: var(--accent-soft);
    }

    .process-note {
      max-width: 70ch;
      color: var(--muted);
    }

    .status-message {
      padding-block: 2rem;
      color: var(--muted);
    }

    @media (max-width: 650px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .dashboard-title-row {
        align-items: flex-start;
      }
    }
  </style>
</Editorial>
