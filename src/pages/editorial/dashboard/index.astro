
---
import Editorial from "../../../layouts/Editorial.astro";

const description = "The DraftLaw Research editorial workspace.";
---

<Editorial title="Editorial Dashboard" description={description}>
  <div class="wrap">
    <header class="page-title dashboard-heading dashboard-title-row">
      <div>
        <p class="eyebrow">EDITORIAL WORKSPACE</p>
        <h1>Editorial Dashboard</h1>
        <p>Manage submissions, contributors and website sections from one place.</p>
      </div>
      <div class="notification-area" id="notification-area" hidden>
        <button
          type="button"
          class="notification-bell"
          id="notification-toggle"
          aria-label="Open notifications"
          aria-expanded="false"
          aria-controls="notification-panel"
        >
          <span aria-hidden="true">🔔</span>
          <span class="notification-indicator" id="notification-indicator" hidden></span>
        </button>
        <section class="notification-panel" id="notification-panel" hidden>
          <div class="notification-panel-heading">
            <h2>Notifications</h2>
            <span id="notification-count">0 unread</span>
          </div>
          <p class="notification-empty">Your notifications will appear here.</p>
        </section>
      </div>
    </header>

    <div id="workspace" hidden>
      <section class="section">
        <div class="section-head">
          <h2 id="workspace-heading">Editorial Workspace</h2>
        </div>

        <div class="dashboard-grid">
          <article class="dashboard-card active-card" id="submissions">
            <p class="eyebrow">01 / REVIEW</p>
            <h3>Submissions</h3>
            <p>Review and manage submitted Articles and Guidelines.</p>
            <a class="action-button" href="/editorial/submissions/new/">Open submissions →</a>
          </article>

          <article class="dashboard-card" id="authors">
            <p class="eyebrow">02 / CONTRIBUTORS</p>
            <h3>Authors</h3>
            <p>Create and publish author profiles for the website.</p>
            <a class="action-button" href="/editorial/dashboard/authors/">Create author profile →</a>
          </article>

          
<article class="dashboard-card" id="topics">
  <p class="eyebrow">03 / WEBSITE SECTION</p>
  <h3>Topics</h3>
  <p>Create and publish topics and categories used across the website.</p>
  <a class="action-button" href="/editorial/dashboard/topics/">Create topic →</a>
</article>


          
<article class="dashboard-card" id="team-members">
  <p class="eyebrow">04 / WEBSITE SECTION</p>
  <h3>Team Members</h3>
  <p>Add and publish members of the DraftLaw Research team.</p>
  <a class="action-button" href="/editorial/dashboard/team/">Add team member →</a>
</article>


          
<article class="dashboard-card" id="student-collaborators">
  <p class="eyebrow">05 / WEBSITE SECTION</p>
  <h3>Student Collaborators</h3>
  <p>Add and publish Student Collaborator profiles.</p>
  <a class="action-button" href="/editorial/dashboard/student-collaborators/">Add Student Collaborator →</a>
</article>


          
<article class="dashboard-card" id="newsletter-items">
  <p class="eyebrow">06 / WEBSITE SECTION</p>
  <h3>Newsletter Items</h3>
  <p>Publish calls for papers, events, competitions and opportunities.</p>
  <a class="action-button" href="/editorial/dashboard/newsletter/">Add newsletter item →</a>
</article>


          <article class="dashboard-card" id="programs">
            <p class="eyebrow">07 / INITIATIVES</p>
            <h3>Programs</h3>
            <p>Create and manage DraftLaw Research programs.</p>
            <a class="action-button" href="/editorial/dashboard/programs/">Add a program →</a>
          </article>

          <article class="dashboard-card" id="announcements">
  <p class="eyebrow">08 / INITIATIVES</p>
  <h3>Program Announcements</h3>
  <p>Publish open calls, program updates and results.</p>
  <a class="action-button" href="/editorial/dashboard/announcements/">
    Add an announcement →
  </a>
</article>

          <article class="dashboard-card admin-only" id="accounts" hidden>
            <p class="eyebrow">09 / ADMINISTRATION</p>
            <h3>Editor Accounts</h3>
            <p>Create editor accounts and manage their access to the portal.</p>
            <a class="action-button" href="/editorial/admin/accounts/">Manage editor accounts →</a>
          </article>

          <article class="dashboard-card admin-only" id="activity" hidden>
            <p class="eyebrow">10 / ADMINISTRATION</p>
            <h3>Activity Log</h3>
            <p>Review actions performed by administrators and editors.</p>
            <span class="coming-soon">Activity records coming soon</span>
          </article>
        </div>
      </section>

      <section class="section" id="process">
        <div class="section-head">
          <h2>Editorial process</h2>
        </div>
        <p class="process-note">
          Changes proposed by editors will require administrative approval
          before they can be published on the public website.
        </p>
      </section>
    </div>

    <p id="status-message" role="status" class="status-message">
      Verifying your session...
    </p>
  </div>

  <script>
    const $ = (selector) => document.querySelector(selector);

    const notificationToggle = $("#notification-toggle");
    const notificationPanel = $("#notification-panel");

    notificationToggle.addEventListener("click", () => {
      const opening = notificationPanel.hidden;
      notificationPanel.hidden = !opening;
      notificationToggle.setAttribute("aria-expanded", String(opening));
    });

    async function loadDashboard() {
      const status = $("#status-message");
      const workspace = $("#workspace");

      try {
        const response = await fetch("/api/auth/me", {
          credentials: "same-origin",
          cache: "no-store"
        });

        if (!response.ok) {
          window.location.replace("/editorial");
          return;
        }

        const result = await response.json();

        if (!result.ok || !result.user ||
            !["admin", "editor"].includes(result.user.role)) {
          window.location.replace("/editorial");
          return;
        }

        const currentRole = result.user.role;

        $("#editorial-user-name").textContent =
          currentRole === "admin" ? "Admin" : result.user.username;

        $("#workspace-heading").textContent =
          currentRole === "admin" ? "Admin Workspace" : "Editor Workspace";

        if (currentRole === "admin") {
          $("#admin-shortcuts").hidden = false;
          document.querySelectorAll(".admin-only").forEach((item) => {
            item.hidden = false;
          });
        } else {
          $("#editor-shortcuts").hidden = false;
        }

        $("#editorial-account").hidden = false;
        $("#notification-area").hidden = false;
        workspace.hidden = false;
        status.hidden = true;
      } catch {
        status.textContent =
          "We could not verify your session. Please refresh or log in again.";
      }
    }

    loadDashboard();
  </script>

  <style>
    .dashboard-title-row {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .notification-area {
      position: relative;
      flex: 0 0 auto;
    }

    .notification-bell {
      position: relative;
      width: 46px;
      height: 46px;
      border: 1px solid var(--rule);
      border-radius: 50%;
      background: transparent;
      color: var(--text);
      font-size: 1.45rem;
      cursor: pointer;
    }

    .notification-bell:hover {
      background: var(--accent-soft);
    }

    .notification-indicator {
      position: absolute;
      top: 5px;
      right: 5px;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #d34b4b;
      box-shadow: 0 0 0 3px var(--surface), 0 0 10px #d34b4b;
    }

    .notification-panel {
      position: absolute;
      z-index: 5;
      top: 56px;
      right: 0;
      width: min(320px, calc(100vw - 2rem));
      padding: 1rem;
      border: 1px solid var(--rule);
      background: var(--surface);
      box-shadow: 0 12px 35px rgb(0 0 0 / 14%);
    }

    .notification-panel-heading {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: center;
    }

    .notification-panel-heading h2 {
      margin: 0;
      font-size: 1rem;
    }

    .notification-panel-heading span,
    .notification-empty {
      color: var(--muted);
      font-size: .85rem;
    }

    .notification-empty {
      margin: 1rem 0 .2rem;
    }

    .dashboard-heading {
      padding-top: 2rem;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
      background: transparent;
      border: 0;
    }

    .dashboard-card {
  position: relative;
  min-width: 0;
  padding: 1.7rem;

  border: 1px solid rgba(255, 255, 255, 0.13);
  border-radius: 16px;

  /* Solid black floating card */
  background: rgba(3, 3, 3, 0.88);

  /* Floating depth */
  box-shadow:
    0 25px 60px rgba(0, 0, 0, 0.55),
    0 8px 22px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.06);

  -webkit-backdrop-filter: blur(22px);
  backdrop-filter: blur(22px);

  transition:
    transform 0.25s ease,
    border-color 0.25s ease,
    box-shadow 0.25s ease;
}

.dashboard-card:hover {
  transform: translateY(-4px);
  border-color: rgba(182, 157, 115, 0.55);

  box-shadow:
    0 32px 70px rgba(0, 0, 0, 0.65),
    0 12px 28px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.08);
}

    .coming-soon {
      display: inline-block;
      margin-top: 0.6rem;
      padding-top: 0.7rem;
      border-top: 1px solid var(--rule);
      font-family: var(--font-ui);
      font-size: 0.78rem;
      color: var(--accent);
    }

    .action-button,
    .back-button {
      border: 1px solid var(--accent);
      background: transparent;
      color: var(--accent);
      padding: 0.7rem 1rem;
      cursor: pointer;
      font: inherit;
      font-size: 0.88rem;
    }

    .action-button {
      display: inline-block;
      margin-top: 0.8rem;
      text-decoration: none;
    }

    .action-button:hover,
    .back-button:hover {
      background: var(--accent-soft);
    }

    .process-note {
      max-width: 70ch;
      color: var(--muted);
    }

    .status-message {
      padding-block: 2rem;
      color: var(--muted);
    }

    @media (max-width: 650px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .dashboard-title-row {
        align-items: flex-start;
      }
    }
  </style>
</Editorial>
