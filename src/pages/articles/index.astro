---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, getTopics } from '../../lib/content';

const articles = await getArticles();
const topics = await getTopics();
const kinds = [...new Set(articles.map((a) => a.data.kind))];
const years = [...new Set(articles.map((a) => a.data.date.getUTCFullYear()))].sort((a, b) => b - a);
---

<Base title="Articles" description="Browse all DraftLaw Research articles by topic, type, year or keyword.">
  <div class="wrap">
    <div class="page-title">
      <p class="eyebrow">Archive</p>
      <h1>Articles</h1>
      <p>Filter by topic, type or year, or search by title, author and keyword.</p>
    </div>

    <form class="filters" role="search" onsubmit="return false">
      <div>
        <label for="q">Search</label>
        <input id="q" type="search" placeholder="Title, author or keyword" autocomplete="off" />
      </div>
      <div>
        <label for="topic">Topic</label>
        <select id="topic">
          <option value="">All topics</option>
          {topics.map((t) => <option value={t.id}>{t.data.name}</option>)}
        </select>
      </div>
      <div>
        <label for="kind">Type</label>
        <select id="kind">
          <option value="">All types</option>
          {kinds.map((k) => <option value={k}>{k}</option>)}
        </select>
      </div>
      <div>
        <label for="year">Year</label>
        <select id="year">
          <option value="">All years</option>
          {years.map((y) => <option value={String(y)}>{y}</option>)}
        </select>
      </div>
    </form>

    <p class="result-count" id="count" aria-live="polite">
      Showing articles
    </p>

    <ul class="list" id="list">
      {articles.map((a) => (
        <li
          data-topic={a.topic.id}
          data-kind={a.data.kind}
          data-year={a.data.date.getUTCFullYear()}
          data-text={[a.data.title, a.data.summary, ...a.authors.map((x) => x.data.name), ...a.data.keywords]
            .join(' ')
            .toLowerCase()}
        >
          <ArticleCard article={a} variant="row" />
        </li>
      ))}
    </ul>

    <p class="empty" id="empty" hidden>
      No articles match these filters. Try removing one.
    </p>

    <nav class="pagination" id="pagination" aria-label="Article pages"></nav>
  </div>
</Base>

<script>
  const $ = <T extends HTMLElement>(id: string) =>
    document.getElementById(id) as T;

  const q = $<HTMLInputElement>('q');
  const topic = $<HTMLSelectElement>('topic');
  const kind = $<HTMLSelectElement>('kind');
  const year = $<HTMLSelectElement>('year');
  const count = $('count');
  const empty = $('empty');
  const pagination = $('pagination');

  const items = Array.from(
    document.querySelectorAll<HTMLElement>('#list > li')
  );

  const perPage = 6;
  let currentPage = 1;

  function readUrl() {
    const params = new URLSearchParams(location.search);

    q.value = params.get('q') ?? '';
    topic.value = params.get('topic') ?? '';
    kind.value = params.get('kind') ?? '';
    year.value = params.get('year') ?? '';

    currentPage = Math.max(
      1,
      Number.parseInt(params.get('page') ?? '1', 10) || 1
    );
  }

  function updateUrl(replace = false) {
    const params = new URLSearchParams();

    if (q.value.trim()) params.set('q', q.value.trim());
    if (topic.value) params.set('topic', topic.value);
    if (kind.value) params.set('kind', kind.value);
    if (year.value) params.set('year', year.value);
    if (currentPage > 1) params.set('page', String(currentPage));

    const query = params.toString();
    const url = location.pathname + (query ? `?${query}` : '') + location.hash;

    if (replace) {
      history.replaceState(null, '', url);
    } else {
      history.pushState(null, '', url);
    }
  }

  function renderPagination(totalPages: number) {
    pagination.replaceChildren();
    pagination.hidden = totalPages <= 1;

    if (totalPages <= 1) return;

    function addLink(label: string, page: number, disabled = false, current = false) {
      const link = document.createElement('a');
      link.textContent = label;
      link.href = `?page=${page}`;
      link.dataset.page = String(page);

      if (disabled) {
        link.setAttribute('aria-disabled', 'true');
        link.tabIndex = -1;
      }

      if (current) {
        link.setAttribute('aria-current', 'page');
      }

      if (disabled) link.classList.add('disabled');

      pagination.append(link);
    }

    addLink('← Previous', currentPage - 1, currentPage === 1);

    for (let page = 1; page <= totalPages; page++) {
      addLink(String(page), page, false, page === currentPage);
    }

    addLink('Next →', currentPage + 1, currentPage === totalPages);
  }

  function apply(updateHistory = false) {
    const text = q.value.trim().toLowerCase();

    const matching = items.filter((li) =>
      (!topic.value || li.dataset.topic === topic.value) &&
      (!kind.value || li.dataset.kind === kind.value) &&
      (!year.value || li.dataset.year === year.value) &&
      (!text || (li.dataset.text ?? '').includes(text))
    );

    const total = matching.length;
    const totalPages = Math.ceil(total / perPage);

    currentPage = totalPages
      ? Math.min(currentPage, totalPages)
      : 1;

    const start = (currentPage - 1) * perPage;
    const visible = new Set(matching.slice(start, start + perPage));

    for (const li of items) {
      li.hidden = !visible.has(li);
    }

    if (total === 0) {
      count.textContent = 'Showing 0 of 0 articles';
    } else {
      count.textContent =
        `Showing ${start + 1}–${Math.min(start + perPage, total)} of ${total} articles`;
    }

    empty.hidden = total !== 0;

    renderPagination(totalPages);

    if (updateHistory) updateUrl(true);
  }

  // Support shared links such as /articles/?topic=human-rights&page=2
  readUrl();
  apply();

  [q, topic, kind, year].forEach((el) => {
    el.addEventListener('input', () => {
      currentPage = 1;
      apply(true);
    });
  });

  pagination.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const link = target.closest<HTMLAnchorElement>('a[data-page]');

    if (!link || link.getAttribute('aria-disabled') === 'true') {
      event.preventDefault();
      return;
    }

    event.preventDefault();

    currentPage = Number(link.dataset.page);
    updateUrl();
    apply();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  window.addEventListener('popstate', () => {
    readUrl();
    apply();
  });
</script>

<style>
  .pagination {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 0.5rem;
  margin: 2rem 0;
}

.pagination[hidden] {
  display: none !important;
}

:global(.pagination a) {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 2.5rem;
  min-height: 2.5rem;
  padding: 0.5rem 0.75rem;
  background: transparent !important;
  color: inherit !important;
  border: 1px solid var(--border, #d1d5db) !important;
  border-radius: 0.375rem !important;
  font: inherit;
  text-decoration: none !important;
  cursor: pointer;
}

:global(.pagination a:hover:not(.disabled)) {
  background: transparent !important;
  color: inherit !important;
}

:global(.pagination a[aria-current="page"]) {
  background: transparent !important;
  color: inherit !important;
  border-color: var(--border, #d1d5db) !important;
}

:global(.pagination a[aria-current="page"]) {
  background: var(--text, #222) !important;
  color: var(--background, #fff) !important;
  border-color: var(--text, #222) !important;
}

  #list > li[hidden] {
    display: none !important;
  }
</style>
