
---
import Base from '../../../layouts/Base.astro';
import GuideCard from '../../../components/GuideCard.astro';
import { getGuides } from '../../../lib/content';

const categories = [
  {
    slug: 'moot-court',
    kind: 'Moot Court Guide',
    title: 'Moot Court Guidelines',
    description:
      'Practical guidance on mooting, memorial drafting, oral advocacy, and preparing for moot court competitions.',
  },
  {
    slug: 'research',
    kind: 'Research Guide',
    title: 'Research Guides',
    description:
      'Guidance on legal research, research methods, and developing research projects.',
  },
  {
    slug: 'writing',
    kind: 'Writing Guide',
    title: 'Writing Guides',
    description:
      'Resources for improving legal writing and academic communication.',
  },
  {
    slug: 'academic-skills',
    kind: 'Academic Skills',
    title: 'Academic Skills',
    description:
      'Practical resources for developing essential academic skills.',
  },
  {
    slug: 'other',
    kind: 'Other',
    title: 'Other Guidance',
    description:
      'Additional resources for law students and emerging legal researchers.',
  },
];

export function getStaticPaths() {
  return categories.map((category) => ({
    params: { topic: category.slug },
    props: {
      kind: category.kind,
      title: category.title,
      description: category.description,
    },
  }));
}

const { kind, title, description } = Astro.props;
const allGuides = await getGuides();

const categoryGuides = allGuides.filter(
  (guide) => (guide.data.kind ?? 'Other') === kind,
);
---

<Base title={title} description={description}>
  <div class="wrap">
    <header class="page-title">
      <p class="eyebrow">
        <a href="/guidance/">Guidelines and Guidance</a>
      </p>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>

    {categoryGuides.length > 0 ? (
      <section class="section">
        <div class="grid">
          {categoryGuides.map((guide) => (
            <GuideCard guide={guide} />
          ))}
        </div>
      </section>
    ) : (
      <section class="section">
        <div class="empty-state">
          <h2>Guides coming soon</h2>
          <p>
            We are preparing resources for this category. Please check back soon.
          </p>
        </div>
      </section>
    )}
  </div>
</Base>
