
---
import Base from '../../layouts/Base.astro';
import GuideCard from '../../components/GuideCard.astro';
import { getGuides } from '../../lib/content';

const guides = await getGuides();

const groupedGuides = Object.values(
  guides.reduce<
    Record<
      string,
      {
        title: string;
        slug: string;
        guides: typeof guides;
      }
    >
  >((groups, guide) => {
    const kind = guide.data.kind ?? 'Other';

    const slugMap: Record<string, string> = {
      'Moot Court Guide': 'moot-court',
      'Research Guide': 'research',
      'Writing Guide': 'writing',
      'Academic Skills': 'academic-skills',
      Other: 'other',
    };

    const slug = slugMap[kind] ?? 'other';

    if (!groups[slug]) {
      groups[slug] = {
        title:
          kind === 'Moot Court Guide'
            ? 'Moot Court Guidelines'
            : kind === 'Other'
              ? 'Other Guidance'
              : kind,
        slug,
        guides: [],
      };
    }

    groups[slug].guides.push(guide);
    return groups;
  }, {}),
).sort((a, b) => a.title.localeCompare(b.title));
---

<Base
  title="Guidelines and Guidance"
  description="Practical legal research, writing, moot court, and academic guidance from DraftLaw Research."
>
  <div class="wrap">
    <header class="page-title">
      <p class="eyebrow">Learn and develop</p>
      <h1>Guidelines and Guidance</h1>
      <p>
        Practical resources to help law students and early-career researchers
        strengthen their legal research, writing, advocacy, and academic skills.
      </p>
    </header>

    {groupedGuides.length > 0 ? (
      groupedGuides.map((group) => (
        <section class="section">
          <h2>
            <a href={`/guidance/topics/${group.slug}/`}>
              {group.title}
            </a>
          </h2>

          <div class="grid">
            {group.guides.map((guide) => (
              <GuideCard guide={guide} />
            ))}
          </div>
        </section>
      ))
    ) : (
      <section class="section">
        <div class="empty-state">
          <h2>Guidance publications coming soon</h2>
          <p>
            We are preparing practical resources for law students and
            emerging legal researchers. Please check back soon.
          </p>
        </div>
      </section>
    )}
  </div>
</Base>
